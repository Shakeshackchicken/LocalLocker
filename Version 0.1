                }) {
                    Image(systemName: "paperplane.fill")
                        .foregroundColor(.white)
                        .padding(12)
                        .background(Color.logoCyan)
                        .clipShape(Circle())
                }
            }
            .padding()
            .background(Color(.systemBackground))
        }
        .navigationTitle(thread.partnerName)
        .navigationBarTitleDisplayMode(.inline)
    }
}

