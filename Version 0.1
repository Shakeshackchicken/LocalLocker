// MARK: - Exact Logo Palette Colors
extension Color {
    init(hex: String) {
        let hex = hex.trimmingCharacters(in: CharacterSet.alphanumerics.inverted)
        var int: UInt64 = 0
        Scanner(string: hex).scanHexInt64(&int)
        let a, r, g, b: UInt64
        switch hex.count {
        case 3:
            (a, r, g, b) = (255, (int >> 8) * 17, (int >> 4 & 0xF) * 17, (int & 0xF) * 17)
        case 6:
            (a, r, g, b) = (255, int >> 16, int >> 8 & 0xFF, int & 0xFF)
        case 8:
            (a, r, g, b) = (int >> 24, int >> 16 & 0xFF, int >> 8 & 0xFF, int & 0xFF)
        default:
            (a, r, g, b) = (1, 1, 1, 0)
        }
        self.init(
            .sRGB,
            red: Double(r) / 255,
            green: Double(g) / 255,
            blue: Double(b) / 255,
            opacity: Double(a) / 255
        )
    }

    static let logoNavy   = Color(hex: "#2A3A8C")
    static let logoCyan   = Color(hex: "#00A3E0")
    static let logoOrange = Color(hex: "#F26522")
    static let logoGold   = Color(hex: "#F8971D")
}

// MARK: - Data Models
enum ProfileType {
    case business, team
}

enum RoleType: String, CaseIterable {
    case sponsor = "Business Sponsor"
    case team = "Sports Team"
}

enum OfferStatus: String {
    case pending = "Pending"
    case accepted = "Accepted"
    case declined = "Declined"
    
    var color: Color {
        switch self {
        case .pending: return .logoOrange
        case .accepted: return .green
        case .declined: return .red
        }
    }
}

struct UserPost: Identifiable, Equatable {
    let id: UUID
    var title: String
    var content: String
    var dateString: String
    
    init(id: UUID = UUID(), title: String, content: String, dateString: String = "Just Now") {
        self.id = id
        self.title = title
        self.content = content
        self.dateString = dateString
    }
}

struct SponsorProfile: Identifiable {
    let id = UUID()
    let name: String
    let type: ProfileType
    let category: String
    let rating: Double
    let description: String
    let locationName: String
    let distance: String
    let budgetOrFundsNeeded: String
    let color: Color
    let imageName: String
    let coordinate: CLLocationCoordinate2D
}

struct UserAccount {
    var name: String
    var email: String
    var role: RoleType
    var organizationName: String
    var location: String
    var bio: String
    var avatarImageName: String
    var isVerified: Bool
    var posts: [UserPost]
}

struct SponsorshipOffer: Identifiable {
    let id = UUID()
    let partnerName: String
    let date: String
    let amount: String
    let terms: String
    var status: OfferStatus
    let isIncoming: Bool
}

struct ChatMessage: Identifiable {
    let id = UUID()
    let isFromUser: Bool
    let text: String
    let time: String
}

struct ChatThread: Identifiable {
    let id = UUID()
    let partnerName: String
    let partnerImage: String
    let partnerColor: Color
    var lastMessageTime: String
    var lastMessageText: String
