        SponsorshipOffer(partnerName: "Kowloon Sports Gear", date: "Oct 10, 2024", amount: "$2,500 HKD", terms: "Social media shoutouts (x4).", status: .accepted, isIncoming: false)
    ]
    
    @Published var chatThreads: [ChatThread] = [
        ChatThread(partnerName: "Central Coffee Roasters", partnerImage: "cup.and.saucer.fill", partnerColor: .logoOrange, lastMessageTime: "10:42 AM", lastMessageText: "Sounds great! Let's review the contract.", messages: [
            ChatMessage(isFromUser: false, text: "Hi Alex, we are interested in sponsoring the jerseys.", time: "10:30 AM"),
            ChatMessage(isFromUser: true, text: "That's wonderful! I can send over the design mockups today.", time: "10:35 AM"),
            ChatMessage(isFromUser: false, text: "Sounds great! Let's review the contract.", time: "10:42 AM")
        ])
    ]
    
    @Published var notifications: [AppNotification] = [
        AppNotification(title: "Offer Accepted!", message: "Kowloon Sports Gear accepted your proposal.", time: "2h ago", icon: "checkmark.seal.fill", color: .green, isRead: false),
        AppNotification(title: "New Message", message: "Central Coffee Roasters sent you a message.", time: "4h ago", icon: "message.fill", color: .logoCyan, isRead: false),
        AppNotification(title: "Escrow Deposit", message: "$2,500 HKD has been secured in Escrow.", time: "1d ago", icon: "lock.shield.fill", color: .logoNavy, isRead: true)
    ]
    
    func updateOfferStatus(id: UUID, newStatus: OfferStatus) {
        if let index = offers.firstIndex(where: { $0.id == id }) {
            offers[index].status = newStatus
        }
    }
    
    func sendMessage(to partnerName: String, text: String) {
        if let index = chatThreads.firstIndex(where: { $0.partnerName == partnerName }) {
            let newMessage = ChatMessage(isFromUser: true, text: text, time: "Now")
            chatThreads[index].messages.append(newMessage)
            chatThreads[index].lastMessageText = text
            chatThreads[index].lastMessageTime = "Now"
        }
    }
    
    func markAllNotificationsRead() {
        for i in 0..<notifications.count {
            notifications[i].isRead = true
        }
    }
}

