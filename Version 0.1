struct ChatDetailView: View {
    @EnvironmentObject var appState: AppStateManager
    let thread: ChatThread
    @State private var messageText = ""
    
    var currentThread: ChatThread {
        appState.chatThreads.first(where: { $0.partnerName == thread.partnerName }) ?? thread
    }
    
    var body: some View {
        VStack {
            ScrollView {
                LazyVStack(spacing: 12) {
                    ForEach(currentThread.messages) { msg in
                        HStack {
                            if msg.isFromUser { Spacer() }
                            VStack(alignment: msg.isFromUser ? .trailing : .leading, spacing: 2) {
                                Text(msg.text)
                                    .padding(12)
                                    .background(msg.isFromUser ? Color.logoCyan : Color(.systemGray5))
                                    .foregroundColor(msg.isFromUser ? .white : .primary)
                                    .cornerRadius(16)
                                Text(msg.time)
                                    .font(.caption2)
                                    .foregroundColor(.secondary)
                            }
                            if !msg.isFromUser { Spacer() }
                        }
                        .padding(.horizontal)
                    }
                }
                .padding(.vertical)
            }
            
            HStack(spacing: 12) {
                TextField("Type a message...", text: $messageText)
                    .padding(12)
                    .background(Color(.systemGray6))
                    .cornerRadius(20)
                
                Button(action: {
                    guard !messageText.isEmpty else { return }
                    appState.sendMessage(to: thread.partnerName, text: messageText)
