struct AIPitchAssistantView: View {
    @State private var targetSponsor = ""
    @State private var pitchFocus = "Financial Support"
    @State private var generatedPitch = ""
    @State private var isGenerating = false
    
    let focusOptions = ["Financial Support", "Equipment", "Venue Space", "Cross-Promotion"]
    
    var body: some View {
        Form {
            Section("Pitch Details") {
                TextField("Who are you pitching to?", text: $targetSponsor)
                Picker("Primary Ask", selection: $pitchFocus) {
                    ForEach(focusOptions, id: \.self) {
                        Text($0)
                    }
                }
            }
            
            Section {
                Button(action: generatePitch) {
                    HStack {
                        Spacer()
                        if isGenerating {
                            ProgressView()
                                .progressViewStyle(CircularProgressViewStyle(tint: .white))
                        } else {
                            Text("Generate Magic Pitch")
                                .bold()
                        }
                        Spacer()
                    }
                    .padding(.vertical, 8)
                    .foregroundColor(.white)
                }
                .listRowBackground(Color.logoNavy)
                .disabled(targetSponsor.isEmpty || isGenerating)
            }
            
            if !generatedPitch.isEmpty {
                Section("Your AI Generated Pitch") {
                    TextEditor(text: $generatedPitch)
                        .frame(minHeight: 200)
                        .font(.body)
                }
            }
        }
        .navigationTitle("AI Pitch Assistant")
    }
    
    func generatePitch() {
        isGenerating = true
        generatedPitch = ""
        
        DispatchQueue.main.asyncAfter(deadline: .now() + 1.2) {
            isGenerating = false
            let sponsorName = targetSponsor.isEmpty ? "[Sponsor Name]" : targetSponsor
            generatedPitch = """
            Dear \(sponsorName) Team,

            We love the impact you make in the local community and believe a partnership would be mutually beneficial. 
            
            Our organization is looking for a sponsorship focused on \(pitchFocus). In return, we can offer prominent logo placement and engaging community shoutouts tailored to your brand.
            
            I'd love to chat further about how we can support each other!
            
            Best regards,
            [Your Name]
            """
        }
    }
}
