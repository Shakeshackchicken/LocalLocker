// MARK: - Home Feed (Role-Filtered Visibility)
struct HomeFeedView: View {
    @EnvironmentObject var appState: AppStateManager
    @State private var showNotifications = false
    @State private var searchText = ""
    
    var unreadCount: Int {
        appState.notifications.filter { !$0.isRead }.count
    }
    
    // Filter profiles based on current user role:
    // - Sports Teams see only Businesses
    // - Business Sponsors see only Sports Teams
    var filteredProfiles: [SponsorProfile] {
        let userRole = appState.currentUser?.role ?? .team
        
        // Base list filtered by cross-role restriction
        let roleFilteredList = MasterData.allProfiles.filter { profile in
            if userRole == .team {
                return profile.type == .business // Sports teams only see businesses
            } else {
                return profile.type == .team     // Businesses only see sports teams
            }
        }
        
        // Apply search text query if present
        if searchText.isEmpty {
            return roleFilteredList
        } else {
            return roleFilteredList.filter {
                $0.name.localizedCaseInsensitiveContains(searchText) ||
                $0.category.localizedCaseInsensitiveContains(searchText) ||
                $0.locationName.localizedCaseInsensitiveContains(searchText)
            }
        }
    }
    
    var body: some View {
        NavigationStack {
            ScrollView {
                ScrollView(.horizontal, showsIndicators: false) {
                    HStack(spacing: 12) {
                        NavigationLink(destination: AIPitchAssistantView()) {
                            ExtraFeatureChip(title: "AI Pitch Assistant", icon: "sparkles", color: .logoGold)
                        }
                        NavigationLink(destination: ExtraFeaturesHubView()) {
                            ExtraFeatureChip(title: "Trust & Safety", icon: "shield.fill", color: .logoNavy)
                        }
                        NavigationLink(destination: SavedPartnershipsView()) {
                            ExtraFeatureChip(title: "Saved Profiles", icon: "bookmark.fill", color: .logoCyan)
                        }
                    }
                    .padding(.horizontal)
                    .padding(.vertical, 8)
                }
                
                LazyVStack(spacing: 16) {
                    if filteredProfiles.isEmpty {
                        VStack(spacing: 8) {
                            Image(systemName: "magnifyingglass")
                                .font(.system(size: 32))
                                .foregroundColor(.secondary)
                            Text("No matching profiles available.")
                                .font(.subheadline)
                                .foregroundColor(.secondary)
                        }
                        .padding(.top, 60)
                    } else {
                        ForEach(filteredProfiles) { profile in
                            NavigationLink(destination: IndividualProfileView(profile: profile)) {
                                SponsorProfileCard(profile: profile)
                            }
                            .buttonStyle(.plain)
                        }
                    }
                }
                .padding(.bottom)
            }
            .background(Color(.systemGroupedBackground))
            .navigationTitle("Discover")
            .searchable(text: $searchText, prompt: appState.currentUser?.role == .team ? "Search business sponsors..." : "Search sports teams...")
            .toolbar {
                ToolbarItem(placement: .topBarLeading) {
                    NavigationLink(destination: InteractiveMapView()) {
                        Image(systemName: "map.fill")
                            .foregroundColor(.logoNavy)
                    }
                }
                ToolbarItem(placement: .topBarTrailing) {
                    Button(action: { showNotifications = true }) {
                        ZStack(alignment: .topTrailing) {
                            Image(systemName: "bell.fill")
                                .foregroundColor(.logoNavy)
                            if unreadCount > 0 {
                                Circle()
                                    .fill(Color.logoOrange)
                                    .frame(width: 10, height: 10)
                                    .offset(x: 2, y: -2)
                            }
                        }
                    }
                }
            }
            .sheet(isPresented: $showNotifications) {
                NotificationsSheetView()
            }
        }
    }
}

