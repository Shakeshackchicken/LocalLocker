// MARK: - Edit Profile Sheet
struct EditProfileView: View {
    @EnvironmentObject var appState: AppStateManager
    @Environment(\.dismiss) var dismiss
    
    @State private var name: String = ""
    @State private var organizationName: String = ""
    @State private var location: String = ""
    @State private var bio: String = ""
    @State private var selectedAvatar: String = "sportscourt.fill"
    
    @State private var userPosts: [UserPost] = []
    @State private var newPostTitle: String = ""
    @State private var newPostContent: String = ""
    @State private var showNewPostSheet = false
    
    let availableAvatars = [
        "sportscourt.fill", "figure.run", "cup.and.saucer.fill",
        "figure.cross.training", "bag.fill", "baseball.fill",
        "star.fill", "shield.fill"
    ]
    
    var body: some View {
        NavigationStack {
            Form {
                Section("Profile Avatar Icon") {
                    ScrollView(.horizontal, showsIndicators: false) {
                        HStack(spacing: 16) {
                            ForEach(availableAvatars, id: \.self) { avatar in
                                ZStack {
                                    Circle()
                                        .fill(selectedAvatar == avatar ? Color.logoCyan : Color(.systemGray5))
                                        .frame(width: 50, height: 50)
                                    Image(systemName: avatar)
                                        .font(.title3)
                                        .foregroundColor(selectedAvatar == avatar ? .white : .primary)
                                }
                                .onTapGesture { selectedAvatar = avatar }
                            }
                        }
                        .padding(.vertical, 8)
                    }
                }
                
                Section("Organization & Contact Info") {
                    TextField("Full Name", text: $name)
                    TextField("Organization Name", text: $organizationName)
                    TextField("Location", text: $location)
                }
                
                Section("Organization Bio") {
                    TextEditor(text: $bio)
                        .frame(height: 90)
                }
                
                Section(header: HStack {
                    Text("Organization News & Updates")
                    Spacer()
                    Button(action: { showNewPostSheet = true }) {
                        Label("Add Post", systemImage: "plus.circle.fill")
                            .font(.caption)
                            .foregroundColor(.logoOrange)
                    }
                }) {
                    if userPosts.isEmpty {
                        Text("No posts created yet.")
                            .font(.caption)
                            .foregroundColor(.secondary)
                    } else {
                        ForEach(userPosts) { post in
                            VStack(alignment: .leading, spacing: 4) {
                                Text(post.title)
                                    .font(.headline)
                                Text(post.content)
                                    .font(.subheadline)
                                    .foregroundColor(.secondary)
                                    .lineLimit(2)
                            }
                            .padding(.vertical, 4)
                        }
                        .onDelete(perform: deletePost)
                    }
                }
            }
            .navigationTitle("Edit Profile")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .cancellationAction) {
                    Button("Cancel") { dismiss() }
                }
                ToolbarItem(placement: .confirmationAction) {
                    Button("Save") {
                        if let current = appState.currentUser {
                            appState.currentUser = UserAccount(
                                name: name.isEmpty ? current.name : name,
                                email: current.email,
                                role: current.role,
                                organizationName: organizationName.isEmpty ? current.organizationName : organizationName,
                                location: location.isEmpty ? current.location : location,
                                bio: bio.isEmpty ? current.bio : bio,
                                avatarImageName: selectedAvatar,
                                isVerified: current.isVerified,
                                posts: userPosts
                            )
                        }
                        dismiss()
                    }
                }
            }
            .onAppear {
                if let current = appState.currentUser {
                    name = current.name
                    organizationName = current.organizationName
                    location = current.location
                    bio = current.bio
                    selectedAvatar = current.avatarImageName
                    userPosts = current.posts
                }
            }
            .sheet(isPresented: $showNewPostSheet) {
                NavigationStack {
                    Form {
                        Section("New Post Header") {
                            TextField("Headline / Title", text: $newPostTitle)
                        }
                        Section("Post Content") {
                            TextEditor(text: $newPostContent)
                                .frame(height: 120)
                        }
                    }
                    .navigationTitle("Create Post")
                    .navigationBarTitleDisplayMode(.inline)
                    .toolbar {
                        ToolbarItem(placement: .cancellationAction) {
                            Button("Cancel") {
                                newPostTitle = ""
                                newPostContent = ""
                                showNewPostSheet = false
                            }
                        }
                        ToolbarItem(placement: .confirmationAction) {
                            Button("Add") {
                                guard !newPostTitle.isEmpty else { return }
                                let createdPost = UserPost(title: newPostTitle, content: newPostContent, dateString: "Just Now")
                                userPosts.insert(createdPost, at: 0)
                                newPostTitle = ""
                                newPostContent = ""
                                showNewPostSheet = false
                            }
                            .disabled(newPostTitle.isEmpty)
                        }
                    }
                }
            }
        }
    }
    
    func deletePost(at offsets: IndexSet) {
        userPosts.remove(atOffsets: offsets)
    }
}

