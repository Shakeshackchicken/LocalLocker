    init(name: String,
         email: String,
         role: RoleType,
         organizationName: String,
         location: String,
         bio: String,
         avatarImageName: String,
         isVerified: Bool,
         posts: [Post],
         tagline: String = "",
         accent: ProfileAccent = .navy,
         coverStyle: CoverStyle = .gradient,
         avatarFile: String? = nil,
         coverFile: String? = nil,
         tags: [String] = [],
         website: String = "",
         instagram: String = "",
         founded: String = "",
         packages: [SponsorshipPackage] = []) {
        self.name = name
        self.email = email
        self.role = role
        self.organizationName = organizationName
        self.location = location
        self.bio = bio
        self.avatarImageName = avatarImageName
        self.isVerified = isVerified
        self.posts = posts
        self.tagline = tagline
        self.accent = accent
        self.coverStyle = coverStyle
        self.avatarFile = avatarFile
        self.coverFile = coverFile
        self.tags = tags
        self.website = website
        self.instagram = instagram
        self.founded = founded
        self.packages = packages
    }

    // Tolerant decoding so accounts saved by older app versions still load.
    init(from decoder: Decoder) throws {
        let c = try decoder.container(keyedBy: CodingKeys.self)
        name = (try? c.decode(String.self, forKey: .name)) ?? "User"
        email = (try? c.decode(String.self, forKey: .email)) ?? ""
        role = (try? c.decode(RoleType.self, forKey: .role)) ?? .team
        organizationName = (try? c.decode(String.self, forKey: .organizationName)) ?? "My Organization"
        location = (try? c.decode(String.self, forKey: .location)) ?? "Hong Kong"
        bio = (try? c.decode(String.self, forKey: .bio)) ?? ""
        avatarImageName = (try? c.decode(String.self, forKey: .avatarImageName)) ?? "sportscourt.fill"
        isVerified = (try? c.decode(Bool.self, forKey: .isVerified)) ?? false
        posts = (try? c.decode([Post].self, forKey: .posts)) ?? []
        tagline = (try? c.decode(String.self, forKey: .tagline)) ?? ""
        accent = (try? c.decode(ProfileAccent.self, forKey: .accent)) ?? .navy
        coverStyle = (try? c.decode(CoverStyle.self, forKey: .coverStyle)) ?? .gradient
        avatarFile = try? c.decodeIfPresent(String.self, forKey: .avatarFile)
        coverFile = try? c.decodeIfPresent(String.self, forKey: .coverFile)
        tags = (try? c.decode([String].self, forKey: .tags)) ?? []
        website = (try? c.decode(String.self, forKey: .website)) ?? ""
        instagram = (try? c.decode(String.self, forKey: .instagram)) ?? ""
        founded = (try? c.decode(String.self, forKey: .founded)) ?? ""
        packages = (try? c.decode([SponsorshipPackage].self, forKey: .packages)) ?? []
    }
}

/// Everything the shared profile screen needs, whether it's your own profile or someone else's.
struct ProfileStat: Identifiable {
    let value: String
    let label: String
    var id: String { label }
}

struct ProfileDisplay {
    let id: String
    let name: String
    let subtitle: String
    let kindLabel: String
    let tagline: String
    let bio: String
    let accent: Color
    let coverStyle: CoverStyle
    let coverFile: String?
    let avatarFile: String?
    let avatarSymbol: String
    let tags: [String]
    let website: String
    let instagram: String
    let founded: String
    let location: String
    let isVerified: Bool
    let posts: [Post]
    let packages: [SponsorshipPackage]
    let fundingLabel: String
    let fundingValue: String
    let stats: [ProfileStat]
}

extension SponsorProfile {
    func display(isFollowing: Bool) -> ProfileDisplay {
        ProfileDisplay(
            id: id,
            name: name,
            subtitle: category,
            kindLabel: type == .business ? "Sponsor" : "Sports Team",
            tagline: tagline,
            bio: description,
            accent: color,
            coverStyle: coverStyle,
            coverFile: nil,
            avatarFile: nil,
            avatarSymbol: imageName,
            tags: tags,
            website: website,
            instagram: instagram,
            founded: founded,
            location: locationName,
            isVerified: true,
            posts: posts,
            packages: packages,
            fundingLabel: type == .team ? "Funding needed" : "Sponsorship budget",
            fundingValue: budgetOrFundsNeeded,
            stats: [
                ProfileStat(value: "\(posts.count)", label: "Posts"),
                ProfileStat(value: Format.compact(followers + (isFollowing ? 1 : 0)), label: "Followers"),
                ProfileStat(value: String(format: "%.1f", rating), label: "Rating")
            ]
        )
    }
}

