    private var addTile: some View {
        Button(action: { onNewPost?() }) {
            VStack(spacing: 8) {
                Image(systemName: "plus.circle.fill")
                    .font(.system(size: 30))
                Text("Add a photo post")
                    .font(.caption)
                    .fontWeight(.semibold)
            }
            .foregroundColor(display.accent)
            .frame(maxWidth: .infinity)
            .frame(height: 130)
            .background(display.accent.opacity(0.08))
            .overlay(
                RoundedRectangle(cornerRadius: 18, style: .continuous)
                    .strokeBorder(display.accent.opacity(0.5), style: StrokeStyle(lineWidth: 1.5, dash: [6, 5]))
            )
            .clipShape(RoundedRectangle(cornerRadius: 18, style: .continuous))
        }
    }

    // MARK: Updates (timeline)
    @ViewBuilder
    private var updatesContent: some View {
        VStack(spacing: 14) {
            if isOwner {
                Button(action: { onNewPost?() }) {
                    HStack(spacing: 12) {
                        AvatarTag(
                            symbol: display.avatarSymbol,
                            accent: display.accent,
                            image: display.avatarFile.flatMap { ImageStore.load($0) },
                            size: 40
                        )
                        Text("Share an update, photo or sponsorship need...")
                            .font(.subheadline)
                            .foregroundColor(.secondary)
                            .multilineTextAlignment(.leading)
                        Spacer()
                        Image(systemName: "square.and.pencil")
                            .foregroundColor(display.accent)
                    }
                    .padding(12)
                    .background(Color(.systemBackground))
                    .clipShape(RoundedRectangle(cornerRadius: 18, style: .continuous))
                }
                .buttonStyle(.plain)
            }

            if display.posts.isEmpty {
                EmptyHint(icon: "text.bubble", text: isOwner ? "Nothing posted yet. Share your first update!" : "No updates yet.")
            } else {
                VStack(spacing: 0) {
                    ForEach(Array(display.posts.enumerated()), id: \.element.id) { index, post in
                        UpdateRow(post: post, display: display, isLast: index == display.posts.count - 1, isOwner: isOwner)
                    }
                }
            }
        }
    }

    // MARK: About
    private var facts: [ProfileFact] {
        var list: [ProfileFact] = [
            ProfileFact(icon: "mappin.and.ellipse", label: "Location", value: display.location)
        ]
        if !display.founded.trimmed.isEmpty {
            list.append(ProfileFact(icon: "calendar", label: "Founded", value: display.founded))
        }
        if !display.fundingValue.isEmpty {
            list.append(ProfileFact(icon: "banknote.fill", label: display.fundingLabel, value: display.fundingValue))
        }
        if let url = Format.webURL(display.website) {
            list.append(ProfileFact(icon: "globe", label: "Website", value: display.website.trimmed, url: url))
        }
        let handle = display.instagram.trimmed.replacingOccurrences(of: "@", with: "")
        if !handle.isEmpty, let url = URL(string: "https://instagram.com/\(handle)") {
            list.append(ProfileFact(icon: "camera.fill", label: "Instagram", value: "@\(handle)", url: url))
        }
        return list
    }

    @ViewBuilder
    private var aboutContent: some View {
        VStack(spacing: 14) {
            SectionCard(title: "Our Story") {
                Text(display.bio.trimmed.isEmpty ? "No description yet." : display.bio)
                    .font(.subheadline)
                    .foregroundColor(.secondary)
            }

            SectionCard(title: "Quick Facts") {
                VStack(spacing: 12) {
                    ForEach(Array(facts.enumerated()), id: \.element.id) { index, fact in
                        FactRow(fact: fact, accent: display.accent)
                        if index < facts.count - 1 {
                            Divider()
                        }
                    }
                }
            }

            if !display.tags.isEmpty {
                SectionCard(title: "Focus & Interests") {
                    FlowLayout(spacing: 8) {
                        ForEach(display.tags, id: \.self) { tag in
                            Text(tag)
                                .font(.caption)
                                .fontWeight(.semibold)
                                .padding(.horizontal, 12)
                                .padding(.vertical, 6)
                                .background(display.accent.opacity(0.14))
                                .foregroundColor(display.accent)
                                .clipShape(Capsule())
                        }
                    }
                }
            }
        }
    }

    // MARK: Packages
    @ViewBuilder
    private var packagesContent: some View {
        VStack(spacing: 14) {
            if display.packages.isEmpty {
                EmptyHint(
                    icon: "shippingbox",
                    text: isOwner ? "No packages yet. Add sponsorship packages in Edit Profile." : "No packages listed yet."
                )
            } else {
                ForEach(display.packages) { package in
                    PackageCard(package: package, accent: display.accent, showAction: !isOwner) {
                        onChoosePackage?(package)
                    }
                }
            }
        }
    }
}

