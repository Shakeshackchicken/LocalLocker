// MARK: - App State Manager
final class AppStateManager: ObservableObject {
    private enum Keys {
        static let authenticated = "isAuthenticated"
        static let user = "currentUser"
        static let saved = "savedProfileIDs"
        static let drafts = "draftProposals"
        static let liked = "likedPostIDs"
        static let following = "followingIDs"
    }

    @Published var selectedTab: AppTab = .discover

    @Published var isAuthenticated: Bool = false {
        didSet { UserDefaults.standard.set(isAuthenticated, forKey: Keys.authenticated) }
    }

    @Published var currentUser: UserAccount? = UserAccount(
        name: "Alex Johnson",
        email: "alex@locallocker.com",
        role: .team,
        organizationName: "Victoria Peak Athletics",
        location: "Hong Kong",
        bio: "Building grassroots sports communities and empowering local youth talent. We run weekly training sessions for kids aged 8 to 16 and welcome local partners who want to grow with us.",
        avatarImageName: "figure.run",
        isVerified: true,
        posts: [
            Post(id: "me-1", title: "Autumn League Tryouts", content: "Excited to announce our open tryouts next Saturday at Victoria Park!", date: Date().addingTimeInterval(-86400 * 2), kind: .event, artworkSymbol: "figure.run"),
            Post(id: "me-2", title: "New Equipment Partner", content: "Huge thanks to our community partners for providing top-tier training kits this season.", date: Date().addingTimeInterval(-86400 * 7), kind: .update, artworkSymbol: "gift.fill")
        ],
        tagline: "Grassroots sport for every kid.",
        accent: .navy,
        coverStyle: .gradient,
        tags: ["Youth", "Athletics", "Hong Kong"],
        founded: "2020",
        packages: [
            SponsorshipPackage(id: "me-p1", name: "Season Partner", amount: 8000, perks: "Logo on team jerseys\nShoutouts on social media\nBanner at home events")
        ]
    ) {
        didSet {
            if let user = currentUser { Store.save(user, key: Keys.user) }
        }
    }

    @Published var walletBalance: Double = 14500.00

    @Published var transactions: [WalletTransaction] = [
        WalletTransaction(title: "Escrow deposit – Kowloon Sports Gear", amount: 2500, date: Date().addingTimeInterval(-86400 * 2)),
        WalletTransaction(title: "Initial funding", amount: 12000, date: Date().addingTimeInterval(-86400 * 9))
    ]

    @Published var offers: [SponsorshipOffer] = [
        SponsorshipOffer(partnerName: "Central Coffee Roasters", date: Date().addingTimeInterval(-86400 * 2), amount: 5000, terms: "Logo on primary team jerseys for 1 season.", status: .pending, isIncoming: true),
        SponsorshipOffer(partnerName: "Harbour Fitness Co.", date: Date().addingTimeInterval(-86400 * 3), amount: 3000, terms: "Free training sessions and logo on training bibs.", status: .pending, isIncoming: true),
        SponsorshipOffer(partnerName: "Kowloon Sports Gear", date: Date().addingTimeInterval(-86400 * 4), amount: 2500, terms: "Social media shoutouts (x4).", status: .accepted, isIncoming: false)
    ]

    @Published var chatThreads: [ChatThread] = [
        ChatThread(partnerName: "Central Coffee Roasters", partnerImage: "cup.and.saucer.fill", partnerColor: .logoOrange, messages: [
            ChatMessage(isFromUser: false, text: "Hi Alex, we are interested in sponsoring the jerseys.", date: Date().addingTimeInterval(-720)),
            ChatMessage(isFromUser: true, text: "That's wonderful! I can send over the design mockups today.", date: Date().addingTimeInterval(-420)),
            ChatMessage(isFromUser: false, text: "Sounds great! Let's review the contract.", date: Date().addingTimeInterval(-60))
        ])
    ]

    @Published var notifications: [AppNotification] = [
        AppNotification(title: "Offer Accepted!", message: "Kowloon Sports Gear accepted your proposal.", time: "2h ago", icon: "checkmark.seal.fill", color: .green, isRead: false),
        AppNotification(title: "New Message", message: "Central Coffee Roasters sent you a message.", time: "4h ago", icon: "message.fill", color: .logoCyan, isRead: false),
        AppNotification(title: "Escrow Deposit", message: "$2,500 HKD has been secured in Escrow.", time: "1d ago", icon: "lock.shield.fill", color: .logoNavy, isRead: true)
    ]

    @Published var savedProfileIDs: Set<String> = ["central-coffee", "kowloon-stags"] {
        didSet { Store.save(Array(savedProfileIDs), key: Keys.saved) }
    }

    @Published var likedPostIDs: Set<String> = [] {
        didSet { Store.save(Array(likedPostIDs), key: Keys.liked) }
    }

    @Published var followingIDs: Set<String> = [] {
        didSet { Store.save(Array(followingIDs), key: Keys.following) }
    }

    @Published var drafts: [DraftProposal] = [
        DraftProposal(recipient: "Kowloon Sports Gear", focus: "Equipment", body: "Dear Kowloon Sports Gear Team,\n\nWe would love to partner with you for the upcoming season. We are looking for equipment support and can offer prominent logo placement in return.\n\nKind regards,\nAlex Johnson", date: Date().addingTimeInterval(-86400 * 3)),
        DraftProposal(recipient: "Autumn Tournament Subsidies", focus: "Financial Support", body: "Hi team,\n\nWe are seeking financial support to help cover entry fees and travel for the autumn tournament.\n\nCheers,\nAlex Johnson", date: Date().addingTimeInterval(-86400 * 6))
    ] {
        didSet { Store.save(drafts, key: Keys.drafts) }
    }

    init() {
        isAuthenticated = UserDefaults.standard.bool(forKey: Keys.authenticated)
        if let user = Store.load(UserAccount.self, key: Keys.user) { currentUser = user }
        if let ids = Store.load([String].self, key: Keys.saved) { savedProfileIDs = Set(ids) }
        if let ids = Store.load([String].self, key: Keys.liked) { likedPostIDs = Set(ids) }
        if let ids = Store.load([String].self, key: Keys.following) { followingIDs = Set(ids) }
        if let storedDrafts = Store.load([DraftProposal].self, key: Keys.drafts) { drafts = storedDrafts }
    }

    // MARK: Derived data
    var discoverableProfiles: [SponsorProfile] {
        let target = (currentUser?.role ?? .team).discoverableType
        return MasterData.allProfiles.filter { $0.type == target }
    }

    var savedProfiles: [SponsorProfile] {
        MasterData.allProfiles.filter { savedProfileIDs.contains($0.id) }
    }

    var pendingIncomingCount: Int {
        offers.filter { $0.isIncoming && $0.status == .pending }.count
    }

    var acceptedOfferCount: Int {
        offers.filter { $0.status == .accepted }.count
    }

    // MARK: Authentication (demo only – replace with a real backend)
    func signIn(email: String) {
        if currentUser == nil {
            currentUser = UserAccount(name: "New User", email: email, role: .team, organizationName: "My Organization", location: "Hong Kong", bio: "", avatarImageName: "sportscourt.fill", isVerified: false, posts: [])
        } else {
            currentUser?.email = email
        }
        isAuthenticated = true
    }

    func signUp(name: String, email: String, organization: String, role: RoleType) {
        currentUser = UserAccount(
            name: name,
            email: email,
            role: role,
            organizationName: organization,
            location: "Hong Kong",
            bio: "",
            avatarImageName: role == .team ? "sportscourt.fill" : "bag.fill",
            isVerified: false,
            posts: []
        )
        isAuthenticated = true
    }

    func signOut() {
        selectedTab = .discover
        isAuthenticated = false
    }

    // MARK: Offers & proposals
    func updateOfferStatus(id: UUID, newStatus: OfferStatus) {
        guard let index = offers.firstIndex(where: { $0.id == id }) else { return }
        let offer = offers[index]
        guard offer.status == .pending else { return }

        offers[index].status = newStatus

        if newStatus == .accepted && offer.isIncoming {
            walletBalance += offer.amount
            transactions.insert(
                WalletTransaction(title: "Escrow deposit – \(offer.partnerName)", amount: offer.amount, date: Date()),
                at: 0
            )
            pushNotification(
                title: "Funds Secured",
                message: "\(Format.hkd(offer.amount)) from \(offer.partnerName) is now held in Escrow.",
                icon: "lock.shield.fill",
                color: .logoNavy
            )
        }
    }

    func sendProposal(to profile: SponsorProfile, amount: Double, terms: String) {
        offers.insert(
            SponsorshipOffer(partnerName: profile.name, date: Date(), amount: amount, terms: terms, status: .pending, isIncoming: false),
            at: 0
        )
        pushNotification(
            title: "Proposal Sent",
            message: "Your \(Format.hkd(amount)) proposal was sent to \(profile.name).",
            icon: "paperplane.fill",
            color: .logoCyan
        )
    }

    // MARK: Chat
    @discardableResult
    func startChat(with profile: SponsorProfile) -> UUID {
        if let existing = chatThreads.first(where: { $0.partnerName == profile.name }) {
            return existing.id
        }
        let thread = ChatThread(partnerName: profile.name, partnerImage: profile.imageName, partnerColor: profile.color, messages: [])
        chatThreads.insert(thread, at: 0)
        return thread.id
    }

    func sendMessage(threadID: UUID, text: String) {
        let clean = text.trimmed
        guard !clean.isEmpty,
              let index = chatThreads.firstIndex(where: { $0.id == threadID }) else { return }
        chatThreads[index].messages.append(ChatMessage(isFromUser: true, text: clean, date: Date()))
    }

    // MARK: Notifications
    func markNotificationRead(id: UUID) {
        if let index = notifications.firstIndex(where: { $0.id == id }) {
            notifications[index].isRead = true
        }
    }

    func markAllNotificationsRead() {
        for i in notifications.indices {
            notifications[i].isRead = true
        }
    }

    func deleteNotifications(at offsets: IndexSet) {
        notifications.remove(atOffsets: offsets)
    }

    private func pushNotification(title: String, message: String, icon: String, color: Color) {
        notifications.insert(
            AppNotification(title: title, message: message, time: "Just now", icon: icon, color: color, isRead: false),
            at: 0
        )
    }

    // MARK: Saved profiles
    func isSaved(_ profile: SponsorProfile) -> Bool {
        savedProfileIDs.contains(profile.id)
    }

    func toggleSaved(_ profile: SponsorProfile) {
        if savedProfileIDs.contains(profile.id) {
            savedProfileIDs.remove(profile.id)
        } else {
            savedProfileIDs.insert(profile.id)
        }
    }

    // MARK: Following & likes
    func isFollowing(_ profile: SponsorProfile) -> Bool {
        followingIDs.contains(profile.id)
    }

    func toggleFollow(_ profile: SponsorProfile) {
        if followingIDs.contains(profile.id) {
            followingIDs.remove(profile.id)
        } else {
            followingIDs.insert(profile.id)
        }
    }

    func isLiked(_ post: Post) -> Bool {
        likedPostIDs.contains(post.id)
    }

    func toggleLike(_ post: Post) {
        if likedPostIDs.contains(post.id) {
            likedPostIDs.remove(post.id)
        } else {
            likedPostIDs.insert(post.id)
        }
    }

    // MARK: Posts
    func addPost(title: String, content: String, kind: PostKind, images: [UIImage]) {
        let files = images.prefix(4).compactMap { ImageStore.save($0) }
        let post = Post(title: title.trimmed, content: content.trimmed, date: Date(), kind: kind, imageFiles: files)
        currentUser?.posts.insert(post, at: 0)
    }

    func deletePost(id: String) {
        guard let post = currentUser?.posts.first(where: { $0.id == id }) else { return }
        post.imageFiles.forEach { ImageStore.delete($0) }
        currentUser?.posts.removeAll { $0.id == id }
        likedPostIDs.remove(id)
    }

    // MARK: Wallet
    func addFunds(_ amount: Double) {
        guard amount > 0 else { return }
        walletBalance += amount
        transactions.insert(WalletTransaction(title: "Funds added", amount: amount, date: Date()), at: 0)
    }

    @discardableResult
    func withdraw(_ amount: Double) -> Bool {
        guard amount > 0, amount <= walletBalance else { return false }
        walletBalance -= amount
        transactions.insert(WalletTransaction(title: "Withdrawal", amount: -amount, date: Date()), at: 0)
        return true
    }

    // MARK: Drafts
    func saveDraft(recipient: String, focus: String, body: String) {
        drafts.insert(DraftProposal(recipient: recipient, focus: focus, body: body, date: Date()), at: 0)
    }

    func deleteDrafts(at offsets: IndexSet) {
        drafts.remove(atOffsets: offsets)
    }
}

// MARK: - Root View (Auth -> Onboarding -> Main App)
struct ContentView: View {
    @EnvironmentObject var appState: AppStateManager
    @AppStorage("hasCompletedOnboarding") private var hasCompletedOnboarding = false
    @AppStorage("appearanceMode") private var appearanceRaw = AppearanceMode.system.rawValue

    var body: some View {
        Group {
            if !appState.isAuthenticated {
                AuthenticationView()
            } else if !hasCompletedOnboarding {
                OnboardingView()
            } else {
                MainTabView()
            }
        }
        .preferredColorScheme(AppearanceMode(rawValue: appearanceRaw)?.colorScheme)
        .animation(.easeInOut, value: appState.isAuthenticated)
        .animation(.easeInOut, value: hasCompletedOnboarding)
    }
}

// MARK: - Onboarding
struct OnboardingPage {
    let icon: String
    let title: String
    let message: String
    let color: Color
}

struct OnboardingView: View {
    @EnvironmentObject var appState: AppStateManager
    @AppStorage("hasCompletedOnboarding") private var hasCompletedOnboarding = false
    @State private var currentPage = 0

    private var isTeam: Bool {
        (appState.currentUser?.role ?? .team) == .team
    }

    // Slides adapt to the user's role
    private var pages: [OnboardingPage] {
        let name = appState.currentUser?.name.components(separatedBy: " ").first ?? "there"

        return [
            OnboardingPage(
                icon: "hand.wave.fill",
                title: "Welcome, \(name)!",
                message: isTeam
                    ? "LocalLocker connects your team with local businesses ready to back you."
                    : "LocalLocker connects your brand with local teams that need your support.",
                color: .logoNavy
            ),
            OnboardingPage(
                icon: "magnifyingglass",
                title: "Discover Partners",
                message: isTeam
                    ? "Browse local business sponsors, filter by category, and see them on the map."
                    : "Browse local sports teams, see what funding they need, and find the right community fit.",
                color: .logoCyan
            ),
            OnboardingPage(
                icon: "sparkles",
                title: isTeam ? "Pitch with AI" : "Send Proposals",
                message: isTeam
                    ? "Use the AI Pitch Assistant to draft a polished sponsorship pitch in seconds."
                    : "Send a sponsorship proposal in one tap and review offers from your Wallet.",
                color: .logoGold
            ),
            OnboardingPage(
                icon: "message.fill",
                title: "Chat Directly",
                message: "Talk to your partners in Messages to agree on terms, share designs and finalise the deal.",
                color: .logoOrange
            ),
            OnboardingPage(
                icon: "lock.shield.fill",
                title: "Protected by Escrow",
                message: "Funds are held securely in your Escrow Vault until both sides are happy, so everyone is protected.",
                color: .logoNavy
            ),
            OnboardingPage(
                icon: "photo.on.rectangle.angled",
                title: "Tell Your Story",
                message: "Customise your profile, add a cover and photos, and share updates so partners can see who you really are.",
                color: .logoCyan
            )
        ]
    }

    private var isLastPage: Bool { currentPage == pages.count - 1 }

    var body: some View {
        let allPages = pages

        ZStack {
            LinearGradient(
                colors: [allPages[currentPage].color.opacity(0.15), Color(.systemGroupedBackground)],
                startPoint: .top,
                endPoint: .bottom
            )
            .ignoresSafeArea()
            .animation(.easeInOut(duration: 0.4), value: currentPage)

            VStack(spacing: 0) {
                HStack {
                    Spacer()
                    Button("Skip") { finish() }
                        .font(.subheadline)
                        .fontWeight(.semibold)
                        .foregroundColor(.secondary)
                        .opacity(isLastPage ? 0 : 1)
                        .disabled(isLastPage)
                }
                .padding(.horizontal, 24)
                .padding(.top, 12)

                TabView(selection: $currentPage) {
                    ForEach(allPages.indices, id: \.self) { index in
                        OnboardingPageView(page: allPages[index])
                            .tag(index)
                    }
                }
                .tabViewStyle(.page(indexDisplayMode: .never))

                HStack(spacing: 8) {
                    ForEach(allPages.indices, id: \.self) { index in
                        Capsule()
                            .fill(index == currentPage ? allPages[currentPage].color : Color(.systemGray4))
                            .frame(width: index == currentPage ? 24 : 8, height: 8)
                    }
                }
                .animation(.spring(response: 0.35, dampingFraction: 0.8), value: currentPage)
                .padding(.bottom, 24)
                .accessibilityElement(children: .ignore)
                .accessibilityLabel("Page \(currentPage + 1) of \(allPages.count)")

                Button(action: {
                    if isLastPage {
                        finish()
                    } else {
                        withAnimation { currentPage += 1 }
                    }
                }) {
                    HStack {
                        Text(isLastPage ? "Get Started" : "Next")
                            .font(.headline)
                        Image(systemName: isLastPage ? "checkmark" : "arrow.right")
                            .font(.subheadline)
                    }
                    .foregroundColor(.white)
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, 16)
                    .background(
                        LinearGradient(colors: [.logoNavy, .logoCyan], startPoint: .leading, endPoint: .trailing)
                    )
                    .cornerRadius(14)
                    .shadow(color: .logoNavy.opacity(0.25), radius: 8, x: 0, y: 4)
                }
                .padding(.horizontal, 24)
                .padding(.bottom, 32)
            }
        }
    }

    private func finish() {
        withAnimation(.easeInOut) {
            hasCompletedOnboarding = true
        }
    }
}

struct OnboardingPageView: View {
    let page: OnboardingPage

    var body: some View {
        VStack(spacing: 28) {
            Spacer()

            ZStack {
                Circle()
                    .fill(page.color.opacity(0.12))
                    .frame(width: 180, height: 180)
                Circle()
                    .fill(page.color.opacity(0.18))
                    .frame(width: 130, height: 130)
                Image(systemName: page.icon)
                    .font(.system(size: 56))
                    .foregroundColor(page.color)
            }

            VStack(spacing: 12) {
                Text(page.title)
                    .font(.system(size: 28, weight: .bold, design: .rounded))
                    .foregroundColor(.logoNavy)
                    .multilineTextAlignment(.center)

                Text(page.message)
                    .font(.body)
                    .foregroundColor(.secondary)
                    .multilineTextAlignment(.center)
                    .padding(.horizontal, 32)
            }

            Spacer()
            Spacer()
