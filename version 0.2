// MARK: - Edit Profile (full personalisation)
struct EditProfileView: View {
    @EnvironmentObject var appState: AppStateManager
    @Environment(\.dismiss) var dismiss

    @State private var name = ""
    @State private var organizationName = ""
    @State private var tagline = ""
    @State private var location = ""
    @State private var founded = ""
    @State private var bio = ""
    @State private var website = ""
    @State private var instagram = ""
    @State private var accent: ProfileAccent = .navy
    @State private var coverStyle: CoverStyle = .gradient
    @State private var avatarSymbol = "sportscourt.fill"
    @State private var tags: [String] = []
    @State private var newTag = ""
    @State private var packages: [SponsorshipPackage] = []

    @State private var existingCoverFile: String?
    @State private var existingAvatarFile: String?
    @State private var coverImage: UIImage?
    @State private var avatarImage: UIImage?
    @State private var removeCover = false
    @State private var removeAvatar = false
    @State private var coverItem: PhotosPickerItem?
    @State private var avatarItem: PhotosPickerItem?
    @State private var showPackageSheet = false

    private let maxBio = 300
    private let maxTagline = 60
    private let maxTags = 6

    let availableAvatars = [
        "sportscourt.fill", "figure.run", "cup.and.saucer.fill",
        "figure.cross.training", "bag.fill", "baseball.fill",
        "star.fill", "shield.fill", "trophy.fill", "flame.fill"
    ]

    private var canSave: Bool {
        !name.trimmed.isEmpty && !organizationName.trimmed.isEmpty
    }

    private var displayCover: UIImage? {
        if let coverImage { return coverImage }
        if removeCover { return nil }
        return existingCoverFile.flatMap { ImageStore.load($0) }
    }

    private var displayAvatar: UIImage? {
        if let avatarImage { return avatarImage }
        if removeAvatar { return nil }
        return existingAvatarFile.flatMap { ImageStore.load($0) }
    }

    var body: some View {
        NavigationStack {
            Form {
                // Live preview
                Section {
                    ZStack(alignment: .bottomLeading) {
                        CoverView(style: coverStyle, accent: accent.color, image: displayCover)
                            .frame(height: 120)
                            .clipShape(RoundedRectangle(cornerRadius: 20, style: .continuous))
                        AvatarTag(symbol: avatarSymbol, accent: accent.color, image: displayAvatar, size: 64)
                            .offset(x: 16, y: 26)
                    }
                    .padding(.bottom, 26)
                    .padding(.vertical, 6)
                    .listRowInsets(EdgeInsets(top: 8, leading: 12, bottom: 8, trailing: 12))
                    .listRowBackground(Color.clear)
                } header: {
                    Text("Preview")
                }

                // Cover
                Section("Cover") {
                    PhotosPicker(selection: $coverItem, matching: .images) {
                        Label("Choose Cover Photo", systemImage: "photo")
                    }
                    if displayCover != nil {
                        Button(role: .destructive) {
                            coverImage = nil
                            coverItem = nil
                            removeCover = true
                        } label: {
                            Label("Remove Cover Photo", systemImage: "trash")
                        }
                    }
                    VStack(alignment: .leading, spacing: 8) {
                        Text("Or pick a style")
                            .font(.caption)
                            .foregroundColor(.secondary)
                        ScrollView(.horizontal, showsIndicators: false) {
                            HStack(spacing: 10) {
                                ForEach(CoverStyle.allCases) { style in
                                    CoverView(style: style, accent: accent.color)
                                        .frame(width: 78, height: 48)
                                        .clipShape(RoundedRectangle(cornerRadius: 10, style: .continuous))
                                        .overlay(
                                            RoundedRectangle(cornerRadius: 10, style: .continuous)
                                                .stroke(coverStyle == style && displayCover == nil ? Color.primary : Color.clear, lineWidth: 2.5)
                                        )
                                        .onTapGesture {
                                            coverStyle = style
                                            coverImage = nil
                                            coverItem = nil
                                            removeCover = true
                                        }
                                }
                            }
                            .padding(.vertical, 4)
                        }
                    }
                }

                // Avatar
                Section("Profile Photo") {
                    PhotosPicker(selection: $avatarItem, matching: .images) {
                        Label("Choose Profile Photo", systemImage: "person.crop.square")
                    }
                    if displayAvatar != nil {
                        Button(role: .destructive) {
                            avatarImage = nil
                            avatarItem = nil
                            removeAvatar = true
                        } label: {
                            Label("Remove Profile Photo", systemImage: "trash")
                        }
                    }
                    VStack(alignment: .leading, spacing: 8) {
                        Text("Or pick an icon")
                            .font(.caption)
                            .foregroundColor(.secondary)
                        ScrollView(.horizontal, showsIndicators: false) {
                            HStack(spacing: 14) {
                                ForEach(availableAvatars, id: \.self) { symbol in
                                    ZStack {
                                        Circle()
                                            .fill(avatarSymbol == symbol ? accent.color : Color(.systemGray5))
                                            .frame(width: 46, height: 46)
                                        Image(systemName: symbol)
                                            .font(.title3)
                                            .foregroundColor(avatarSymbol == symbol ? .white : .primary)
                                    }
                                    .onTapGesture {
                                        avatarSymbol = symbol
                                        avatarImage = nil
                                        avatarItem = nil
                                        removeAvatar = true
                                    }
                                }
                            }
                            .padding(.vertical, 4)
                        }
                    }
                }

                // Accent colour
                Section("Accent Color") {
                    ScrollView(.horizontal, showsIndicators: false) {
                        HStack(spacing: 14) {
                            ForEach(ProfileAccent.allCases) { option in
                                Circle()
                                    .fill(option.color)
                                    .frame(width: 38, height: 38)
                                    .overlay(
                                        Image(systemName: "checkmark")
                                            .font(.subheadline.bold())
                                            .foregroundColor(.white)
                                            .opacity(accent == option ? 1 : 0)
                                    )
                                    .onTapGesture { withAnimation { accent = option } }
                                    .accessibilityLabel(option.rawValue.capitalized)
                            }
                        }
                        .padding(.vertical, 4)
                    }
                }

                // Identity
                Section(header: Text("Identity"), footer: Text("Name and organization are required.")) {
                    TextField("Your Name", text: $name)
                    TextField("Organization Name", text: $organizationName)
                    TextField("Tagline (e.g. Youth rugby with heart)", text: $tagline)
                    TextField("Location", text: $location)
                    TextField("Founded (year)", text: $founded)
                        .keyboardType(.numberPad)
                }

                // Bio
                Section(header: Text("Our Story"), footer: Text("\(bio.count)/\(maxBio)")) {
                    TextEditor(text: $bio)
                        .frame(height: 110)
                }

                // Tags
                Section(header: Text("Tags"), footer: Text("Up to \(maxTags) tags that describe your focus.")) {
                    if !tags.isEmpty {
                        FlowLayout(spacing: 8) {
                            ForEach(tags, id: \.self) { tag in
                                Button(action: { tags.removeAll { $0 == tag } }) {
                                    HStack(spacing: 4) {
                                        Text(tag)
                                        Image(systemName: "xmark.circle.fill")
                                    }
                                    .font(.caption)
                                    .fontWeight(.semibold)
                                    .padding(.horizontal, 10)
                                    .padding(.vertical, 6)
                                    .background(accent.color.opacity(0.14))
                                    .foregroundColor(accent.color)
                                    .clipShape(Capsule())
                                }
                                .buttonStyle(.borderless)
                            }
                        }
                        .padding(.vertical, 4)
                    }
                    if tags.count < maxTags {
                        HStack {
                            TextField("Add a tag", text: $newTag)
                                .onSubmit(addTag)
                            Button("Add", action: addTag)
                                .buttonStyle(.borderless)
                                .disabled(newTag.trimmed.isEmpty)
                        }
                    }
                }

                // Links
                Section("Links") {
                    TextField("Website (e.g. myteam.hk)", text: $website)
                        .keyboardType(.URL)
                        .textInputAutocapitalization(.never)
                        .autocorrectionDisabled(true)
                    TextField("Instagram handle", text: $instagram)
                        .textInputAutocapitalization(.never)
                        .autocorrectionDisabled(true)
                }

                // Packages
                Section(header: Text("Sponsorship Packages"), footer: Text("Partners can propose these packages straight from your profile.")) {
                    ForEach(packages) { package in
                        VStack(alignment: .leading, spacing: 2) {
                            HStack {
                                Text(package.name)
                                    .font(.headline)
                                Spacer()
                                Text(Format.hkd(package.amount))
                                    .font(.subheadline)
                                    .foregroundColor(accent.color)
                            }
                            Text(package.perks.replacingOccurrences(of: "\n", with: " • "))
                                .font(.caption)
                                .foregroundColor(.secondary)
                                .lineLimit(2)
                        }
                        .padding(.vertical, 2)
                    }
                    .onDelete { packages.remove(atOffsets: $0) }

                    Button(action: { showPackageSheet = true }) {
                        Label("Add Package", systemImage: "plus.circle.fill")
                    }
                }
            }
            .navigationTitle("Edit Profile")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .cancellationAction) {
                    Button("Cancel") { dismiss() }
                }
                ToolbarItem(placement: .confirmationAction) {
                    Button("Save", action: save)
                        .fontWeight(.bold)
                        .disabled(!canSave)
                }
            }
            .onAppear(perform: loadCurrentValues)
            .onChange(of: coverItem) { loadPhoto(from: coverItem, isCover: true) }
            .onChange(of: avatarItem) { loadPhoto(from: avatarItem, isCover: false) }
            .onChange(of: bio) {
                if bio.count > maxBio { bio = String(bio.prefix(maxBio)) }
            }
            .onChange(of: tagline) {
                if tagline.count > maxTagline { tagline = String(tagline.prefix(maxTagline)) }
            }
            .sheet(isPresented: $showPackageSheet) {
                PackageEditorSheet(onSave: { packages.append($0) })
            }
        }
    }

    private func loadCurrentValues() {
        guard let current = appState.currentUser else { return }
        name = current.name
        organizationName = current.organizationName
        tagline = current.tagline
        location = current.location
        founded = current.founded
        bio = current.bio
        website = current.website
        instagram = current.instagram
        accent = current.accent
        coverStyle = current.coverStyle
        avatarSymbol = current.avatarImageName
        tags = current.tags
        packages = current.packages
        existingCoverFile = current.coverFile
        existingAvatarFile = current.avatarFile
    }

    private func addTag() {
        let clean = newTag.trimmed
        guard !clean.isEmpty, tags.count < maxTags, !tags.contains(clean) else {
            newTag = ""
            return
        }
        tags.append(clean)
        newTag = ""
    }

    private func loadPhoto(from item: PhotosPickerItem?, isCover: Bool) {
        guard let item else { return }
        Task {
            if let data = try? await item.loadTransferable(type: Data.self),
               let image = UIImage(data: data) {
                let resized = image.resized(maxDimension: isCover ? 1600 : 700)
                await MainActor.run {
                    if isCover {
                        coverImage = resized
                        removeCover = false
                    } else {
                        avatarImage = resized
                        removeAvatar = false
                    }
                }
            }
        }
    }

    private func save() {
        guard var user = appState.currentUser else { return }

        // Cover photo
        if let image = coverImage, let file = ImageStore.save(image, maxDimension: 1600) {
            if let old = user.coverFile { ImageStore.delete(old) }
            user.coverFile = file
        } else if removeCover, let old = user.coverFile {
            ImageStore.delete(old)
            user.coverFile = nil
        }

        // Profile photo
        if let image = avatarImage, let file = ImageStore.save(image, maxDimension: 700) {
            if let old = user.avatarFile { ImageStore.delete(old) }
            user.avatarFile = file
        } else if removeAvatar, let old = user.avatarFile {
            ImageStore.delete(old)
            user.avatarFile = nil
        }

        user.name = name.trimmed
        user.organizationName = organizationName.trimmed
        user.tagline = tagline.trimmed
        user.location = location.trimmed
        user.founded = founded.trimmed
        user.bio = bio.trimmed
        user.website = website.trimmed
        user.instagram = instagram.trimmed
        user.accent = accent
        user.coverStyle = coverStyle
        user.avatarImageName = avatarSymbol
        user.tags = tags
        user.packages = packages

        appState.currentUser = user
        dismiss()
    }
}

struct PackageEditorSheet: View {
    var onSave: (SponsorshipPackage) -> Void

    @Environment(\.dismiss) var dismiss
    @State private var name = ""
    @State private var amountText = ""
    @State private var perks = ""

    private var parsedAmount: Double? {
        Double(amountText.replacingOccurrences(of: ",", with: "").trimmed)
    }

    private var isValid: Bool {
        !name.trimmed.isEmpty && (parsedAmount ?? 0) > 0
    }

    var body: some View {
        NavigationStack {
            Form {
                Section("Package Name") {
                    TextField("e.g. Main Jersey Sponsor", text: $name)
                }
                Section("Price (HKD)") {
                    TextField("e.g. 5000", text: $amountText)
                        .keyboardType(.decimalPad)
                }
                Section(header: Text("What's Included"), footer: Text("Write one benefit per line.")) {
                    TextEditor(text: $perks)
                        .frame(height: 120)
                }
            }
            .navigationTitle("New Package")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .cancellationAction) {
                    Button("Cancel") { dismiss() }
                }
                ToolbarItem(placement: .confirmationAction) {
                    Button("Add") {
                        guard let amount = parsedAmount else { return }
                        onSave(SponsorshipPackage(name: name.trimmed, amount: amount, perks: perks.trimmed))
                        dismiss()
                    }
                    .disabled(!isValid)
                }
            }
        }
        .presentationDetents([.large])
    }
}

// MARK: - Payments / Wallet View
enum FundsMode: String, Identifiable {
    case add, withdraw
    var id: String { rawValue }
}

struct PaymentsView: View {
    @EnvironmentObject var appState: AppStateManager
    @State private var selectedTab = 0
    @State private var fundsMode: FundsMode?

    var incomingOffers: [SponsorshipOffer] { appState.offers.filter { $0.isIncoming } }
    var outgoingOffers: [SponsorshipOffer] { appState.offers.filter { !$0.isIncoming } }

    var body: some View {
        NavigationStack {
            ScrollView {
                VStack(spacing: 20) {
                    VStack(spacing: 14) {
                        HStack {
                            Text("Escrow Vault Balance")
                                .font(.subheadline)
                                .foregroundColor(.secondary)
                            Spacer()
                            Image(systemName: "lock.shield.fill")
                                .foregroundColor(.logoCyan)
                        }
                        HStack(alignment: .firstTextBaseline) {
                            Text("$\(Format.number(appState.walletBalance, fixed: true))")
                                .font(.system(size: 38, weight: .bold))
                                .foregroundColor(.logoNavy)
                                .minimumScaleFactor(0.6)
                                .lineLimit(1)
                            Text("HKD")
                                .font(.headline)
                                .foregroundColor(.secondary)
                            Spacer()
                        }
                        Divider()
                        HStack(spacing: 12) {
                            Button(action: { fundsMode = .add }) {
                                Label("Add Funds", systemImage: "plus.circle.fill")
                                    .font(.subheadline)
                                    .fontWeight(.semibold)
                                    .frame(maxWidth: .infinity)
                                    .padding(.vertical, 12)
                                    .background(Color.logoNavy)
                                    .foregroundColor(.white)
                                    .cornerRadius(12)
                            }
                            Button(action: { fundsMode = .withdraw }) {
                                Label("Withdraw", systemImage: "arrow.down.circle.fill")
                                    .font(.subheadline)
                                    .fontWeight(.semibold)
                                    .frame(maxWidth: .infinity)
                                    .padding(.vertical, 12)
                                    .background(Color(.systemGray5))
                                    .foregroundColor(.primary)
                                    .cornerRadius(12)
                            }
                        }
                    }
                    .padding(18)
                    .background(Color(.systemBackground))
                    .cornerRadius(20)
                    .shadow(color: Color.black.opacity(0.04), radius: 8, x: 0, y: 2)
                    .padding(.horizontal)

                    // Recent activity
                    VStack(alignment: .leading, spacing: 12) {
                        Text("Recent Activity")
                            .font(.title3)
                            .bold()

                        if appState.transactions.isEmpty {
                            Text("No transactions yet.")
                                .font(.subheadline)
                                .foregroundColor(.secondary)
                        } else {
                            let recent = Array(appState.transactions.prefix(5))
                            VStack(spacing: 0) {
                                ForEach(recent) { tx in
                                    HStack(spacing: 12) {
                                        Image(systemName: tx.icon)
                                            .font(.title3)
                                            .foregroundColor(tx.amount >= 0 ? .green : .red)
                                        VStack(alignment: .leading, spacing: 2) {
                                            Text(tx.title)
                                                .font(.subheadline)
                                                .fontWeight(.medium)
                                            Text(Format.day(tx.date))
                                                .font(.caption)
                                                .foregroundColor(.secondary)
                                        }
                                        Spacer()
                                        Text("\(tx.amount >= 0 ? "+" : "-")\(Format.hkd(abs(tx.amount)))")
                                            .font(.subheadline)
                                            .fontWeight(.semibold)
                                            .foregroundColor(tx.amount >= 0 ? .green : .red)
                                    }
                                    .padding(.vertical, 10)
                                    if tx.id != recent.last?.id {
                                        Divider()
                                    }
                                }
                            }
                            .padding(.horizontal, 16)
                            .padding(.vertical, 6)
                            .background(Color(.systemBackground))
                            .cornerRadius(16)
                        }
                    }
                    .padding(.horizontal)

                    VStack(alignment: .leading, spacing: 14) {
                        Text("Sponsorship Offers")
                            .font(.title3)
                            .bold()
                            .padding(.horizontal)

                        Picker("Offers Type", selection: $selectedTab) {
                            Text("Incoming (\(incomingOffers.count))").tag(0)
                            Text("Outgoing (\(outgoingOffers.count))").tag(1)
                        }
                        .pickerStyle(.segmented)
                        .padding(.horizontal)

                        if selectedTab == 0 {
                            if incomingOffers.isEmpty {
                                Text("No incoming offers right now.")
                                    .font(.subheadline)
                                    .foregroundColor(.secondary)
                                    .padding()
                            } else {
                                LazyVStack(spacing: 12) {
                                    ForEach(incomingOffers) { offer in
                                        IncomingOfferCard(offer: offer)
                                    }
                                }
                                .padding(.horizontal)
                            }
                        } else {
                            if outgoingOffers.isEmpty {
                                Text("No outgoing offers sent yet.")
                                    .font(.subheadline)
                                    .foregroundColor(.secondary)
                                    .padding()
                            } else {
                                LazyVStack(spacing: 12) {
                                    ForEach(outgoingOffers) { offer in
                                        OutgoingOfferCard(offer: offer)
                                    }
                                }
                                .padding(.horizontal)
                            }
                        }
                    }
                }
                .padding(.vertical)
            }
            .background(Color(.systemGroupedBackground))
            .navigationTitle("Wallet")
            .sheet(item: $fundsMode) { mode in
                FundsSheetView(mode: mode)
            }
        }
    }
}

struct FundsSheetView: View {
    let mode: FundsMode
    @EnvironmentObject var appState: AppStateManager
    @Environment(\.dismiss) var dismiss
    @State private var amountText = ""

    private var parsedAmount: Double? {
        Double(amountText.replacingOccurrences(of: ",", with: "").trimmed)
    }

    private var title: String { mode == .add ? "Add Funds" : "Withdraw" }

    private var errorText: String? {
        guard !amountText.trimmed.isEmpty else { return nil }
        guard let value = parsedAmount, value > 0 else { return "Enter a valid amount." }
        if mode == .withdraw && value > appState.walletBalance {
            return "That's more than your available balance."
        }
        return nil
    }

    private var canSubmit: Bool {
        guard let value = parsedAmount, value > 0 else { return false }
        return mode == .add || value <= appState.walletBalance
    }

    var body: some View {
        NavigationStack {
            Form {
                Section(
                    header: Text("Amount (HKD)"),
                    footer: VStack(alignment: .leading, spacing: 4) {
                        if let errorText {
                            Text(errorText).foregroundColor(.red)
                        }
                        if mode == .withdraw {
                            Text("Available: \(Format.hkd(appState.walletBalance))")
                        }
                    }
                ) {
                    TextField("e.g. 5000", text: $amountText)
                        .keyboardType(.decimalPad)
                }

                if mode == .add {
                    Section("Quick Amounts") {
                        HStack(spacing: 10) {
                            ForEach([1000, 5000, 10000], id: \.self) { value in
                                Button("$\(Format.number(Double(value)))") {
                                    amountText = String(value)
                                }
                                .buttonStyle(.borderedProminent)
                                .tint(.logoCyan)
                            }
                        }
                        .buttonStyle(.borderless)
                    }
                }

                Section {
                    Text("Demo only – no real money is moved. Connect a payment provider (e.g. Stripe) to go live.")
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
            }
            .navigationTitle(title)
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .cancellationAction) {
                    Button("Cancel") { dismiss() }
                }
                ToolbarItem(placement: .confirmationAction) {
                    Button(mode == .add ? "Add" : "Withdraw") {
                        guard let value = parsedAmount else { return }
                        if mode == .add {
                            appState.addFunds(value)
                        } else {
                            appState.withdraw(value)
                        }
                        dismiss()
                    }
                    .disabled(!canSubmit)
                }
            }
        }
        .presentationDetents([.medium, .large])
    }
}

