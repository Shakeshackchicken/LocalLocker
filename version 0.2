struct ChatDetailView: View {
    @EnvironmentObject var appState: AppStateManager
    let threadID: UUID
    @State private var messageText = ""

    private var thread: ChatThread? {
        appState.chatThreads.first(where: { $0.id == threadID })
    }

    private var messages: [ChatMessage] { thread?.messages ?? [] }
    private var canSend: Bool { !messageText.trimmed.isEmpty }

    var body: some View {
        VStack(spacing: 0) {
            ScrollViewReader { proxy in
                ScrollView {
                    LazyVStack(spacing: 12) {
                        if messages.isEmpty {
                            Text("Say hello to \(thread?.partnerName ?? "your partner") and start the conversation.")
                                .font(.subheadline)
                                .foregroundColor(.secondary)
                                .multilineTextAlignment(.center)
                                .padding(.top, 60)
                                .padding(.horizontal, 40)
                        }
                        ForEach(messages) { msg in
                            HStack {
                                if msg.isFromUser { Spacer(minLength: 40) }
                                VStack(alignment: msg.isFromUser ? .trailing : .leading, spacing: 2) {
                                    Text(msg.text)
                                        .padding(12)
                                        .background(msg.isFromUser ? Color.logoCyan : Color(.systemGray5))
                                        .foregroundColor(msg.isFromUser ? .white : .primary)
                                        .cornerRadius(16)
                                    Text(Format.time(msg.date))
                                        .font(.caption2)
                                        .foregroundColor(.secondary)
                                }
                                if !msg.isFromUser { Spacer(minLength: 40) }
                            }
                            .padding(.horizontal)
                            .id(msg.id)
                        }
                    }
                    .padding(.vertical)
                }
                .scrollDismissesKeyboard(.interactively)
                .onAppear { scrollToBottom(proxy, animated: false) }
                .onChange(of: messages.count) { scrollToBottom(proxy, animated: true) }
            }

            HStack(spacing: 12) {
                TextField("Type a message...", text: $messageText)
                    .padding(12)
                    .background(Color(.systemGray6))
                    .cornerRadius(20)
                    .submitLabel(.send)
                    .onSubmit(send)

                Button(action: send) {
                    Image(systemName: "paperplane.fill")
                        .foregroundColor(.white)
                        .padding(12)
                        .background(canSend ? Color.logoCyan : Color(.systemGray3))
                        .clipShape(Circle())
                }
                .disabled(!canSend)
                .accessibilityLabel("Send message")
            }
            .padding()
            .background(Color(.systemBackground))
        }
        .navigationTitle(thread?.partnerName ?? "Chat")
        .navigationBarTitleDisplayMode(.inline)
    }

    private func send() {
        guard canSend else { return }
        appState.sendMessage(threadID: threadID, text: messageText)
        messageText = ""
    }

    private func scrollToBottom(_ proxy: ScrollViewProxy, animated: Bool) {
        guard let last = messages.last else { return }
        if animated {
            withAnimation { proxy.scrollTo(last.id, anchor: .bottom) }
        } else {
            proxy.scrollTo(last.id, anchor: .bottom)
        }
    }
}

