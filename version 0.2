/// One profile layout used for both your own profile and everyone else's.
struct ProfileScreen<Actions: View, Footer: View>: View {
    let display: ProfileDisplay
    let isOwner: Bool
    let onNewPost: (() -> Void)?
    let onChoosePackage: ((SponsorshipPackage) -> Void)?
    let actions: Actions
    let footer: Footer

    @EnvironmentObject var appState: AppStateManager
    @State private var tab: ProfileTab = .showcase
    @Namespace private var tabNamespace

    init(display: ProfileDisplay,
         isOwner: Bool = false,
         onNewPost: (() -> Void)? = nil,
         onChoosePackage: ((SponsorshipPackage) -> Void)? = nil,
         @ViewBuilder actions: () -> Actions,
         @ViewBuilder footer: () -> Footer) {
        self.display = display
        self.isOwner = isOwner
        self.onNewPost = onNewPost
        self.onChoosePackage = onChoosePackage
        self.actions = actions()
        self.footer = footer()
    }

    private let showcaseHeights: [CGFloat] = [170, 215, 190, 235]

    var body: some View {
        ScrollView {
            VStack(spacing: 0) {
                header

                VStack(spacing: 18) {
                    statStrip
                    actions
                    tabBar
                    tabContent
                    footer
                }
                .padding(.horizontal)
                .padding(.top, 18)
                .padding(.bottom, 90)
            }
        }
        .scrollIndicators(.hidden)
        .background(Color(.systemGroupedBackground))
    }

    // MARK: Header
    private var header: some View {
        VStack(alignment: .leading, spacing: 0) {
            ZStack(alignment: .bottomLeading) {
                CoverView(
                    style: display.coverStyle,
                    accent: display.accent,
                    image: display.coverFile.flatMap { ImageStore.load($0) }
                )
                .frame(height: 160)
                .clipShape(RoundedRectangle(cornerRadius: 28, style: .continuous))

                AvatarTag(
                    symbol: display.avatarSymbol,
                    accent: display.accent,
                    image: display.avatarFile.flatMap { ImageStore.load($0) },
                    size: 92
                )
                .offset(x: 20, y: 46)
            }
            .padding(.horizontal)
            .padding(.top, 8)

            VStack(alignment: .leading, spacing: 8) {
                HStack(spacing: 6) {
                    Text(display.name)
                        .font(.title2)
                        .fontWeight(.bold)
                    if display.isVerified {
                        Image(systemName: "checkmark.seal.fill")
                            .foregroundColor(.logoCyan)
                            .accessibilityLabel("Verified")
                    }
                }

                if !display.tagline.isEmpty {
                    Text(display.tagline)
                        .font(.subheadline)
                        .fontWeight(.medium)
                        .foregroundColor(display.accent)
                }

                HStack(spacing: 8) {
                    Text(display.kindLabel)
                        .font(.caption2)
                        .fontWeight(.bold)
                        .padding(.horizontal, 8)
                        .padding(.vertical, 4)
                        .background(display.accent.opacity(0.15))
                        .foregroundColor(display.accent)
                        .clipShape(Capsule())
                    Text(display.subtitle)
                        .font(.caption)
                        .foregroundColor(.secondary)
                }

                Label(display.location, systemImage: "mappin.circle.fill")
                    .font(.caption)
                    .foregroundColor(.secondary)
            }
            .padding(.horizontal, 20)
            .padding(.top, 58)
        }
    }

    // MARK: Stats
    private var statStrip: some View {
        HStack(spacing: 0) {
            ForEach(Array(display.stats.enumerated()), id: \.element.id) { index, stat in
                VStack(spacing: 2) {
                    Text(stat.value)
                        .font(.title3)
                        .bold()
                        .foregroundColor(display.accent)
                    Text(stat.label)
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
                .frame(maxWidth: .infinity)

                if index < display.stats.count - 1 {
                    Divider().frame(height: 28)
                }
            }
        }
        .padding(.vertical, 14)
        .background(Color(.systemBackground))
        .clipShape(RoundedRectangle(cornerRadius: 18, style: .continuous))
    }

    // MARK: Tabs
    private var tabBar: some View {
        HStack(spacing: 4) {
            ForEach(ProfileTab.allCases) { item in
                Button(action: {
