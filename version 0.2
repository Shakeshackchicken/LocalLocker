// MARK: - New Post (quick composer)
struct NewPostSheet: View {
    @EnvironmentObject var appState: AppStateManager
    @Environment(\.dismiss) var dismiss

    @State private var kind: PostKind = .update
    @State private var title = ""
    @State private var content = ""
    @State private var pickerItems: [PhotosPickerItem] = []
    @State private var images: [UIImage] = []
    @State private var isLoadingPhotos = false

    private let maxImages = 4
    private let maxChars = 500

    private var accent: Color { appState.currentUser?.accent.color ?? .logoNavy }

    private var canPost: Bool {
        !title.trimmed.isEmpty || !content.trimmed.isEmpty || !images.isEmpty
    }

    var body: some View {
        NavigationStack {
            ScrollView {
                VStack(alignment: .leading, spacing: 20) {
                    // Post type
                    VStack(alignment: .leading, spacing: 8) {
                        Text("POST TYPE")
                            .font(.caption2)
                            .fontWeight(.bold)
                            .foregroundColor(.secondary)
                        ScrollView(.horizontal, showsIndicators: false) {
                            HStack(spacing: 8) {
                                ForEach(PostKind.allCases) { option in
                                    Button(action: { withAnimation(.easeInOut(duration: 0.15)) { kind = option } }) {
                                        Label(option.title, systemImage: option.icon)
                                            .font(.subheadline)
                                            .fontWeight(.semibold)
                                            .padding(.horizontal, 14)
                                            .padding(.vertical, 9)
                                            .background(kind == option ? option.color : Color(.systemBackground))
                                            .foregroundColor(kind == option ? .white : .primary)
                                            .clipShape(Capsule())
                                    }
                                }
                            }
                        }
                    }

                    // Photos
                    VStack(alignment: .leading, spacing: 8) {
                        Text("PHOTOS (UP TO \(maxImages))")
                            .font(.caption2)
                            .fontWeight(.bold)
                            .foregroundColor(.secondary)
                        ScrollView(.horizontal, showsIndicators: false) {
                            HStack(spacing: 10) {
                                ForEach(Array(images.enumerated()), id: \.offset) { index, image in
                                    Image(uiImage: image)
                                        .resizable()
                                        .scaledToFill()
                                        .frame(width: 104, height: 104)
                                        .clipShape(RoundedRectangle(cornerRadius: 16, style: .continuous))
                                        .overlay(alignment: .topTrailing) {
                                            Button(action: { images.remove(at: index) }) {
                                                Image(systemName: "xmark.circle.fill")
                                                    .font(.title3)
                                                    .foregroundColor(.white)
                                                    .shadow(radius: 2)
                                            }
                                            .padding(5)
                                            .accessibilityLabel("Remove photo")
                                        }
                                }

                                if images.count < maxImages {
                                    PhotosPicker(
                                        selection: $pickerItems,
                                        maxSelectionCount: maxImages - images.count,
                                        matching: .images
                                    ) {
                                        VStack(spacing: 6) {
                                            if isLoadingPhotos {
                                                ProgressView()
                                            } else {
                                                Image(systemName: "photo.badge.plus")
                                                    .font(.title2)
                                                Text("Add")
                                                    .font(.caption)
                                                    .fontWeight(.semibold)
                                            }
                                        }
                                        .foregroundColor(accent)
                                        .frame(width: 104, height: 104)
                                        .background(accent.opacity(0.08))
                                        .overlay(
                                            RoundedRectangle(cornerRadius: 16, style: .continuous)
                                                .strokeBorder(accent.opacity(0.5), style: StrokeStyle(lineWidth: 1.5, dash: [6, 5]))
                                        )
                                        .clipShape(RoundedRectangle(cornerRadius: 16, style: .continuous))
                                    }
                                }
                            }
                        }
                    }

                    // Headline
                    TextField("Headline (optional)", text: $title)
                        .font(.headline)
                        .padding(14)
                        .background(Color(.systemBackground))
                        .clipShape(RoundedRectangle(cornerRadius: 14, style: .continuous))

                    // Caption
                    VStack(alignment: .trailing, spacing: 6) {
                        ZStack(alignment: .topLeading) {
                            TextEditor(text: $content)
                                .scrollContentBackground(.hidden)
                                .padding(8)
                                .frame(minHeight: 150)
                                .background(Color(.systemBackground))
                                .clipShape(RoundedRectangle(cornerRadius: 14, style: .continuous))

                            if content.isEmpty {
                                Text(kind.placeholder)
                                    .foregroundColor(.secondary)
                                    .padding(.top, 16)
                                    .padding(.leading, 13)
                                    .allowsHitTesting(false)
                            }
                        }
                        Text("\(content.count)/\(maxChars)")
                            .font(.caption2)
                            .foregroundColor(content.count >= maxChars ? .red : .secondary)
                    }
                }
                .padding()
            }
            .background(Color(.systemGroupedBackground))
            .scrollDismissesKeyboard(.interactively)
            .navigationTitle("New Post")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .cancellationAction) {
                    Button("Cancel") { dismiss() }
                }
                ToolbarItem(placement: .confirmationAction) {
                    Button("Post") { publish() }
                        .fontWeight(.bold)
                        .disabled(!canPost || isLoadingPhotos)
                }
            }
            .onChange(of: pickerItems) { loadPickedItems() }
            .onChange(of: content) {
                if content.count > maxChars {
                    content = String(content.prefix(maxChars))
                }
            }
        }
        .presentationDetents([.large])
    }

    private func loadPickedItems() {
        guard !pickerItems.isEmpty else { return }
        let items = pickerItems
        isLoadingPhotos = true

        Task {
            var loaded: [UIImage] = []
            for item in items {
                if let data = try? await item.loadTransferable(type: Data.self),
                   let image = UIImage(data: data) {
                    loaded.append(image.resized(maxDimension: 1600))
                }
            }
            await MainActor.run {
                let room = maxImages - images.count
                images.append(contentsOf: loaded.prefix(max(0, room)))
                pickerItems = []
                isLoadingPhotos = false
            }
        }
    }

    private func publish() {
        appState.addPost(title: title, content: content, kind: kind, images: images)
        UINotificationFeedbackGenerator().notificationOccurred(.success)
        dismiss()
    }
}

// MARK: - Home Feed (Role-Filtered Visibility)
struct HomeFeedView: View {
    @EnvironmentObject var appState: AppStateManager
    @State private var showNotifications = false
    @State private var searchText = ""
    @State private var selectedCategory = "All"

    var unreadCount: Int {
        appState.notifications.filter { !$0.isRead }.count
    }

    // Sports teams see only businesses; business sponsors see only sports teams.
    var categories: [String] {
        ["All"] + Array(Set(appState.discoverableProfiles.map(\.category))).sorted()
    }

    var filteredProfiles: [SponsorProfile] {
        var list = appState.discoverableProfiles

        if selectedCategory != "All" {
            list = list.filter { $0.category == selectedCategory }
        }

        let query = searchText.trimmed
        guard !query.isEmpty else { return list }

        return list.filter {
            $0.name.localizedCaseInsensitiveContains(query) ||
            $0.category.localizedCaseInsensitiveContains(query) ||
            $0.locationName.localizedCaseInsensitiveContains(query) ||
            $0.tags.contains { $0.localizedCaseInsensitiveContains(query) }
        }
    }

    var body: some View {
        NavigationStack {
            ScrollView {
                VStack(spacing: 8) {
                    ScrollView(.horizontal, showsIndicators: false) {
                        HStack(spacing: 12) {
                            NavigationLink(destination: AIPitchAssistantView()) {
                                ExtraFeatureChip(title: "AI Pitch Assistant", icon: "sparkles", color: .logoGold)
                            }
                            NavigationLink(destination: ExtraFeaturesHubView()) {
                                ExtraFeatureChip(title: "Trust & Safety", icon: "shield.fill", color: .logoNavy)
                            }
                            NavigationLink(destination: SavedPartnershipsView()) {
                                ExtraFeatureChip(title: "Saved Profiles", icon: "bookmark.fill", color: .logoCyan)
                            }
                        }
                        .padding(.horizontal)
                        .padding(.vertical, 8)
                    }

                    ScrollView(.horizontal, showsIndicators: false) {
                        HStack(spacing: 10) {
                            ForEach(categories, id: \.self) { category in
                                Button(action: {
                                    withAnimation(.easeInOut(duration: 0.2)) { selectedCategory = category }
                                }) {
                                    CategoryChip(title: category, isSelected: selectedCategory == category)
                                }
                            }
                        }
                        .padding(.horizontal)
                        .padding(.bottom, 4)
                    }

                    LazyVStack(spacing: 16) {
                        if filteredProfiles.isEmpty {
                            ContentUnavailableView(
                                "No Matching Profiles",
                                systemImage: "magnifyingglass",
                                description: Text("Try a different search or category.")
                            )
                            .padding(.top, 40)
                        } else {
                            ForEach(filteredProfiles) { profile in
                                NavigationLink(destination: IndividualProfileView(profile: profile)) {
                                    SponsorProfileCard(profile: profile, isSaved: appState.isSaved(profile))
                                }
                                .buttonStyle(.plain)
                            }
                        }
                    }
                    .padding(.bottom)
                }
            }
            .background(Color(.systemGroupedBackground))
            .navigationTitle("Discover")
            .searchable(text: $searchText, prompt: appState.currentUser?.role == .team ? "Search business sponsors..." : "Search sports teams...")
            .toolbar {
                ToolbarItem(placement: .topBarLeading) {
                    NavigationLink(destination: InteractiveMapView()) {
                        Image(systemName: "map.fill")
                            .foregroundColor(.logoNavy)
                    }
                    .accessibilityLabel("Open map")
                }
                ToolbarItem(placement: .topBarTrailing) {
                    Button(action: { showNotifications = true }) {
                        ZStack(alignment: .topTrailing) {
                            Image(systemName: "bell.fill")
                                .foregroundColor(.logoNavy)
                            if unreadCount > 0 {
                                Circle()
                                    .fill(Color.logoOrange)
                                    .frame(width: 10, height: 10)
                                    .offset(x: 2, y: -2)
                            }
                        }
                    }
                    .accessibilityLabel("Notifications, \(unreadCount) unread")
                }
            }
            .sheet(isPresented: $showNotifications) {
                NotificationsSheetView()
            }
        }
    }
}

