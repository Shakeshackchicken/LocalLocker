// MARK: - Authentication View
struct AuthenticationView: View {
    @EnvironmentObject var appState: AppStateManager
    @AppStorage("hasCompletedOnboarding") private var hasCompletedOnboarding = false

    @State private var fullName = ""
    @State private var email = ""
    @State private var password = ""
    @State private var orgName = ""
    @State private var isSignUp = false
    @State private var selectedRole: RoleType = .team
    @State private var errorMessage: String?
    @State private var isLoading = false

    var body: some View {
        ZStack {
            LinearGradient(
                colors: [Color.logoNavy.opacity(0.12), Color.logoCyan.opacity(0.08), Color(.systemGroupedBackground)],
                startPoint: .topLeading,
                endPoint: .bottomTrailing
            )
            .ignoresSafeArea()

            ScrollView(showsIndicators: false) {
                VStack(spacing: 24) {
                    Spacer(minLength: 40)

                    VStack(spacing: 12) {
                        Image("AppLogo")
                            .resizable()
                            .scaledToFit()
                            .frame(height: 110)
                            .shadow(color: .logoNavy.opacity(0.18), radius: 12, x: 0, y: 6)

                        Text("LocalLocker")
                            .font(.system(size: 34, weight: .bold, design: .rounded))
                            .foregroundColor(.logoNavy)

                        Text(isSignUp ? "Connect your team or brand today" : "Welcome back! Log in to continue")
                            .font(.subheadline)
                            .foregroundColor(.secondary)
                    }

                    VStack(spacing: 18) {
                        HStack(spacing: 0) {
                            modeButton(title: "Sign In", isActive: !isSignUp) { setMode(signUp: false) }
                            modeButton(title: "Sign Up", isActive: isSignUp) { setMode(signUp: true) }
                        }
                        .padding(4)
                        .background(Color(.systemGray6))
                        .cornerRadius(12)

                        if isSignUp {
                            VStack(alignment: .leading, spacing: 8) {
                                Text("ACCOUNT TYPE")
                                    .font(.caption2)
                                    .fontWeight(.bold)
                                    .foregroundColor(.secondary)

                                Picker("Role", selection: $selectedRole) {
                                    ForEach(RoleType.allCases, id: \.self) { role in
                                        Text(role.rawValue).tag(role)
                                    }
                                }
                                .pickerStyle(.segmented)
                            }
                            .transition(.opacity.combined(with: .move(edge: .top)))
                        }

                        VStack(spacing: 14) {
                            if isSignUp {
                                ModernTextField(icon: "person.fill", placeholder: "Your Name", text: $fullName, capitalization: .words, contentType: .name)
                                    .transition(.opacity.combined(with: .move(edge: .top)))

                                ModernTextField(icon: "building.2.fill", placeholder: "Organization Name", text: $orgName, capitalization: .words, contentType: .organizationName)
                                    .transition(.opacity.combined(with: .move(edge: .top)))
                            }

                            ModernTextField(icon: "envelope.fill", placeholder: "Email address", text: $email, keyboard: .emailAddress, capitalization: .never, contentType: .emailAddress)

                            ModernSecureField(icon: "lock.fill", placeholder: "Password (min. 6 characters)", text: $password, contentType: isSignUp ? .newPassword : .password)
                        }

                        if let errorMessage {
                            Label(errorMessage, systemImage: "exclamationmark.circle.fill")
                                .font(.footnote)
                                .foregroundColor(.red)
                                .frame(maxWidth: .infinity, alignment: .leading)
                                .transition(.opacity)
                        }

                        Button(action: submit) {
                            HStack {
                                if isLoading {
                                    ProgressView()
                                        .progressViewStyle(CircularProgressViewStyle(tint: .white))
                                } else {
                                    Text(isSignUp ? "Create Account" : "Sign In")
                                        .font(.headline)
                                    Image(systemName: "arrow.right")
                                        .font(.subheadline)
                                }
                            }
                            .foregroundColor(.white)
                            .frame(maxWidth: .infinity)
                            .padding(.vertical, 16)
                            .background(
                                LinearGradient(colors: [.logoNavy, .logoCyan], startPoint: .leading, endPoint: .trailing)
                            )
                            .cornerRadius(14)
                            .shadow(color: .logoNavy.opacity(0.25), radius: 8, x: 0, y: 4)
                        }
                        .disabled(isLoading)
                        .padding(.top, 6)
                    }
                    .padding(22)
                    .background(Color(.systemBackground))
                    .cornerRadius(24)
                    .shadow(color: Color.black.opacity(0.06), radius: 15, x: 0, y: 5)
                    .padding(.horizontal)

                    Spacer(minLength: 20)
                }
            }
            .scrollDismissesKeyboard(.interactively)
        }
    }

    private func modeButton(title: String, isActive: Bool, action: @escaping () -> Void) -> some View {
        Button(action: action) {
            Text(title)
                .font(.subheadline)
                .fontWeight(.bold)
                .frame(maxWidth: .infinity)
                .padding(.vertical, 12)
                .background(isActive ? Color(.systemBackground) : Color.clear)
                .foregroundColor(isActive ? .logoNavy : .secondary)
                .cornerRadius(10)
                .shadow(color: isActive ? Color.black.opacity(0.08) : Color.clear, radius: 4)
        }
    }

    private func setMode(signUp: Bool) {
        withAnimation(.spring(response: 0.35, dampingFraction: 0.8)) {
            isSignUp = signUp
            errorMessage = nil
        }
    }

    private func isValidEmail(_ value: String) -> Bool {
        value.trimmed.range(of: #"^[A-Z0-9a-z._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}$"#, options: .regularExpression) != nil
    }

    private func validate() -> String? {
        if isSignUp {
            if fullName.trimmed.isEmpty { return "Please enter your name." }
            if orgName.trimmed.isEmpty { return "Please enter your organization name." }
        }
        if !isValidEmail(email) { return "Please enter a valid email address." }
        if password.count < 6 { return "Password must be at least 6 characters." }
        return nil
    }

    private func submit() {
        if let message = validate() {
            withAnimation { errorMessage = message }
            return
        }

        errorMessage = nil
        isLoading = true

        // Simulated network delay. Replace with a real auth call (Firebase, Supabase, Sign in with Apple, etc.)
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.8) {
            isLoading = false
            withAnimation {
                if isSignUp {
                    hasCompletedOnboarding = false   // new accounts always see the introduction
                    appState.signUp(name: fullName.trimmed, email: email.trimmed, organization: orgName.trimmed, role: selectedRole)
                } else {
                    appState.signIn(email: email.trimmed)
                }
            }
        }
    }
}

