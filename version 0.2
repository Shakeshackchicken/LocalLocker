/// Decorative cover background used when there's no cover photo.
struct CoverBackground: View {
    let style: CoverStyle
    let accent: Color

    var body: some View {
        ZStack {
            LinearGradient(
                colors: [accent, accent.opacity(0.65), Color.logoNavy.opacity(0.9)],
                startPoint: .topLeading,
                endPoint: .bottomTrailing
            )

            switch style {
            case .gradient:
                Color.clear
            case .stripes:
                Canvas { context, size in
                    var x: CGFloat = -size.height
                    while x < size.width {
                        var path = Path()
                        path.move(to: CGPoint(x: x, y: size.height))
                        path.addLine(to: CGPoint(x: x + size.height, y: 0))
                        context.stroke(path, with: .color(.white.opacity(0.12)), lineWidth: 10)
                        x += 28
                    }
                }
            case .dots:
                Canvas { context, size in
                    let spacing: CGFloat = 22
                    var y: CGFloat = 8
                    while y < size.height {
                        var x: CGFloat = 8
                        while x < size.width {
                            context.fill(
                                Path(ellipseIn: CGRect(x: x, y: y, width: 5, height: 5)),
                                with: .color(.white.opacity(0.22))
                            )
                            x += spacing
                        }
                        y += spacing
                    }
                }
            case .rings:
                Canvas { context, size in
                    let center = CGPoint(x: size.width * 0.85, y: size.height * 0.2)
                    for i in 1...6 {
                        let r = CGFloat(i) * 38
                        context.stroke(
                            Path(ellipseIn: CGRect(x: center.x - r, y: center.y - r, width: r * 2, height: r * 2)),
                            with: .color(.white.opacity(0.14)),
                            lineWidth: 2
                        )
                    }
                }
            case .glow:
                ZStack {
                    Circle()
                        .fill(Color.white.opacity(0.28))
                        .frame(width: 180, height: 180)
                        .blur(radius: 40)
                        .offset(x: -80, y: -30)
                    Circle()
                        .fill(Color.logoGold.opacity(0.45))
                        .frame(width: 160, height: 160)
                        .blur(radius: 40)
                        .offset(x: 100, y: 40)
                }
            }
        }
        .clipped()
    }
}

