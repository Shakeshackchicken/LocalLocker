struct SponsorshipPackage: Identifiable, Codable, Equatable {
    var id: String = UUID().uuidString
    var name: String
    var amount: Double
    var perks: String   // one benefit per line
}

struct Post: Identifiable, Codable, Equatable {
    var id: String
    var title: String
    var content: String
    var date: Date
    var kind: PostKind
    var imageFiles: [String]       // file names in ImageStore
    var artworkSymbol: String?     // used by demo content that has no real photo
    var baseLikes: Int

    var hasMedia: Bool { !imageFiles.isEmpty || artworkSymbol != nil }

    init(id: String = UUID().uuidString,
         title: String = "",
         content: String = "",
         date: Date = Date(),
         kind: PostKind = .update,
         imageFiles: [String] = [],
         artworkSymbol: String? = nil,
         baseLikes: Int = 0) {
        self.id = id
        self.title = title
        self.content = content
        self.date = date
        self.kind = kind
        self.imageFiles = imageFiles
        self.artworkSymbol = artworkSymbol
        self.baseLikes = baseLikes
    }

    // Tolerant decoding so data saved by older app versions still loads.
    init(from decoder: Decoder) throws {
        let c = try decoder.container(keyedBy: CodingKeys.self)
        id = (try? c.decode(String.self, forKey: .id)) ?? UUID().uuidString
        title = (try? c.decode(String.self, forKey: .title)) ?? ""
        content = (try? c.decode(String.self, forKey: .content)) ?? ""
        date = (try? c.decode(Date.self, forKey: .date)) ?? Date()
        kind = (try? c.decode(PostKind.self, forKey: .kind)) ?? .update
        imageFiles = (try? c.decode([String].self, forKey: .imageFiles)) ?? []
        artworkSymbol = try? c.decodeIfPresent(String.self, forKey: .artworkSymbol)
        baseLikes = (try? c.decode(Int.self, forKey: .baseLikes)) ?? 0
    }
}

