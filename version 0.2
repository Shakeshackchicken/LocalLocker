                            }
                        }
                }
            }
        }
        .padding(4)
        .background(Color(.systemBackground))
        .clipShape(Capsule())
    }

    @ViewBuilder
    private var tabContent: some View {
        switch tab {
        case .showcase: showcaseContent
        case .updates: updatesContent
        case .about: aboutContent
        case .packages: packagesContent
        }
    }

    // MARK: Showcase (pinboard)
    private var showcasePosts: [Post] {
        display.posts.filter { $0.hasMedia }
    }

    private func column(_ col: Int, of items: [Post]) -> [IndexedPost] {
        items.enumerated().compactMap { pair in
            pair.offset % 2 == col ? IndexedPost(index: pair.offset, post: pair.element) : nil
        }
    }

    @ViewBuilder
    private var showcaseContent: some View {
        let items = showcasePosts
        if items.isEmpty && !isOwner {
            EmptyHint(icon: "photo.on.rectangle.angled", text: "No photos yet.")
        } else {
            HStack(alignment: .top, spacing: 12) {
                VStack(spacing: 14) {
                    if isOwner { addTile }
                    ForEach(column(0, of: items)) { item in
                        ShowcaseCard(post: item.post, display: display, height: showcaseHeights[item.index % 4], isOwner: isOwner)
                    }
                }
                VStack(spacing: 14) {
                    ForEach(column(1, of: items)) { item in
                        ShowcaseCard(post: item.post, display: display, height: showcaseHeights[item.index % 4], isOwner: isOwner)
                    }
                }
            }
        }
