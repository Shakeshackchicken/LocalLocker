struct AIPitchAssistantView: View {
    @EnvironmentObject var appState: AppStateManager

    @State private var targetName = ""
    @State private var pitchFocus = "Financial Support"
    @State private var tone = "Professional"
    @State private var generatedPitch = ""
    @State private var isGenerating = false
    @State private var statusMessage: String?

    let focusOptions = ["Financial Support", "Equipment", "Venue Space", "Cross-Promotion"]
    let toneOptions = ["Professional", "Friendly"]

    private var isTeam: Bool {
        (appState.currentUser?.role ?? .team) == .team
    }

    var body: some View {
        Form {
            Section("Pitch Details") {
                TextField(isTeam ? "Which business are you pitching to?" : "Which team are you contacting?", text: $targetName)
                Picker(isTeam ? "Primary Ask" : "Primary Offer", selection: $pitchFocus) {
                    ForEach(focusOptions, id: \.self) {
                        Text($0)
                    }
                }
                Picker("Tone", selection: $tone) {
                    ForEach(toneOptions, id: \.self) {
                        Text($0)
                    }
                }
                .pickerStyle(.segmented)
            }

            Section {
                Button(action: generatePitch) {
                    HStack {
                        Spacer()
                        if isGenerating {
                            ProgressView()
                                .progressViewStyle(CircularProgressViewStyle(tint: .white))
                        } else {
                            Text("Generate Magic Pitch")
                                .bold()
                        }
                        Spacer()
                    }
                    .padding(.vertical, 8)
                    .foregroundColor(.white)
                }
                .listRowBackground(Color.logoNavy)
                .disabled(targetName.trimmed.isEmpty || isGenerating)
            }

            if !generatedPitch.isEmpty {
                Section("Your AI Generated Pitch") {
                    TextEditor(text: $generatedPitch)
                        .frame(minHeight: 220)
                        .font(.body)
                }

                Section(footer: Text(statusMessage ?? "")) {
                    Button(action: copyPitch) {
                        Label("Copy to Clipboard", systemImage: "doc.on.doc")
                    }
                    Button(action: saveDraft) {
                        Label("Save to Drafts", systemImage: "square.and.arrow.down")
                    }
                }
            }
        }
        .navigationTitle("AI Pitch Assistant")
    }

    private func generatePitch() {
        isGenerating = true
        generatedPitch = ""
        statusMessage = nil

        // Template-based demo. Swap this for a real AI API call when you're ready.
        DispatchQueue.main.asyncAfter(deadline: .now() + 1.2) {
            isGenerating = false

            let recipient = targetName.trimmed
            let sender = appState.currentUser?.name ?? "[Your Name]"
            let org = appState.currentUser?.organizationName ?? "[Your Organization]"
            let focus = pitchFocus.lowercased()
            let friendly = tone == "Friendly"

            let greeting = friendly ? "Hi \(recipient) team," : "Dear \(recipient) Team,"
            let signOff = friendly ? "Cheers," : "Kind regards,"

            let intro: String
            let ask: String
            let closing: String

            if isTeam {
                intro = friendly
                    ? "I'm \(sender) from \(org). We really admire the impact you make in our local community and think we'd be a great match."
                    : "My name is \(sender) from \(org). We admire the impact \(recipient) makes in our local community and believe a partnership would be mutually beneficial."
                ask = "We're looking for sponsorship focused on \(focus). In return, we can offer prominent logo placement, community shoutouts and a visible presence at our events, all tailored to your brand."
                closing = friendly
                    ? "I'd love to chat about how we can support each other!"
                    : "I would welcome the opportunity to discuss how we can support each other."
            } else {
                intro = friendly
                    ? "I'm \(sender) from \(org). We love what your team is doing for the community and would like to get involved."
                    : "My name is \(sender) from \(org). We admire the work your team does in the community and would like to explore a sponsorship."
                ask = "We'd like to support you with \(focus). In return, we'd ask for logo placement on your kit or materials and some local promotion for our brand."
                closing = friendly
                    ? "Let us know if you'd like to talk it through!"
                    : "I would be glad to arrange a call to discuss the details."
            }

            generatedPitch = [greeting, intro, ask, closing, "\(signOff)\n\(sender)\n\(org)"].joined(separator: "\n\n")
        }
    }

    private func copyPitch() {
        UIPasteboard.general.string = generatedPitch
        statusMessage = "Copied to clipboard."
    }

    private func saveDraft() {
        appState.saveDraft(recipient: targetName.trimmed, focus: pitchFocus, body: generatedPitch)
        statusMessage = "Saved! Find it under Profile → Draft Proposals."
    }
}

struct SettingsView: View {
    @AppStorage("appearanceMode") private var appearanceRaw = AppearanceMode.system.rawValue
    @AppStorage("hasCompletedOnboarding") private var hasCompletedOnboarding = true
    @EnvironmentObject var appState: AppStateManager
    @State private var showLogoutAlert = false

    private var appVersion: String {
        Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String ?? "1.0"
    }

    var body: some View {
        Form {
            Section("Appearance") {
                Picker("Theme", selection: $appearanceRaw) {
                    ForEach(AppearanceMode.allCases) { mode in
                        Text(mode.rawValue).tag(mode.rawValue)
                    }
                }
                .pickerStyle(.segmented)
            }

            Section("Account") {
                LabeledContent("Email", value: appState.currentUser?.email ?? "-")
                LabeledContent("Account Type", value: appState.currentUser?.role.rawValue ?? "-")
            }

            Section("Help") {
                Button("Replay Introduction") {
                    hasCompletedOnboarding = false
                }
            }

            Section("About") {
                LabeledContent("Version", value: appVersion)
            }

            Section {
                Button("Log Out") {
                    showLogoutAlert = true
                }
                .foregroundColor(.red)
            }
        }
        .navigationTitle("Account Settings")
        .alert("Log Out", isPresented: $showLogoutAlert) {
            Button("Cancel", role: .cancel) { }
            Button("Log Out", role: .destructive) {
                appState.signOut()
            }
        } message: {
            Text("Are you sure you want to log out?")
        }
    }
}

struct NotificationsSheetView: View {
    @EnvironmentObject var appState: AppStateManager
    @Environment(\.dismiss) var dismiss

    private var hasUnread: Bool {
        appState.notifications.contains { !$0.isRead }
    }

    var body: some View {
        NavigationStack {
            Group {
                if appState.notifications.isEmpty {
                    ContentUnavailableView(
                        "No Notifications",
                        systemImage: "bell.slash",
                        description: Text("You're all caught up.")
                    )
                } else {
                    List {
                        ForEach(appState.notifications) { notif in
                            HStack(alignment: .top, spacing: 12) {
                                ZStack {
                                    Circle()
                                        .fill(notif.color.opacity(0.15))
                                        .frame(width: 40, height: 40)
                                    Image(systemName: notif.icon)
                                        .foregroundColor(notif.color)
                                }

                                VStack(alignment: .leading, spacing: 4) {
                                    Text(notif.title)
                                        .font(.headline)
                                    Text(notif.message)
                                        .font(.subheadline)
                                        .foregroundColor(.secondary)
                                    Text(notif.time)
                                        .font(.caption2)
                                        .foregroundColor(.gray)
                                }

                                Spacer()
                                if !notif.isRead {
                                    Circle()
                                        .fill(Color.logoCyan)
                                        .frame(width: 10, height: 10)
                                        .padding(.top, 6)
                                        .accessibilityLabel("Unread")
                                }
                            }
                            .padding(.vertical, 4)
                            .contentShape(Rectangle())
                            .onTapGesture { appState.markNotificationRead(id: notif.id) }
                        }
                        .onDelete(perform: appState.deleteNotifications)
                    }
                }
            }
            .navigationTitle("Notifications")
            .toolbar {
                ToolbarItem(placement: .topBarLeading) {
                    Button("Mark All Read") {
                        appState.markAllNotificationsRead()
                    }
                    .disabled(!hasUnread)
                }
                ToolbarItem(placement: .confirmationAction) {
                    Button("Done") { dismiss() }
                }
            }
        }
    }
}

