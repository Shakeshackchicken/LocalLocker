// MARK: - Exact Logo Palette Colors
extension Color {
    init(hex: String) {
        let hex = hex.trimmingCharacters(in: CharacterSet.alphanumerics.inverted)
        var int: UInt64 = 0
        Scanner(string: hex).scanHexInt64(&int)
        let a, r, g, b: UInt64
        switch hex.count {
        case 3:
            (a, r, g, b) = (255, (int >> 8) * 17, (int >> 4 & 0xF) * 17, (int & 0xF) * 17)
        case 6:
            (a, r, g, b) = (255, int >> 16, int >> 8 & 0xFF, int & 0xFF)
        case 8:
            (a, r, g, b) = (int >> 24, int >> 16 & 0xFF, int >> 8 & 0xFF, int & 0xFF)
        default:
            (a, r, g, b) = (1, 1, 1, 0)
        }
        self.init(
            .sRGB,
            red: Double(r) / 255,
            green: Double(g) / 255,
            blue: Double(b) / 255,
            opacity: Double(a) / 255
        )
    }

    static let logoNavy   = Color(hex: "#2A3A8C")
    static let logoCyan   = Color(hex: "#00A3E0")
    static let logoOrange = Color(hex: "#F26522")
    static let logoGold   = Color(hex: "#F8971D")
    static let logoGreen  = Color(hex: "#2EAD6B")
    static let logoPurple = Color(hex: "#7B4FD6")
    static let logoRose   = Color(hex: "#E0457B")
}

// MARK: - Helpers
extension String {
    var trimmed: String { trimmingCharacters(in: .whitespacesAndNewlines) }
}

extension UIImage {
    /// Downscales so the longest side is at most `maxDimension` pixels.
    func resized(maxDimension: CGFloat) -> UIImage {
        let largest = max(size.width, size.height)
        guard largest > maxDimension else { return self }
        let scale = maxDimension / largest
        let newSize = CGSize(width: size.width * scale, height: size.height * scale)
        let format = UIGraphicsImageRendererFormat()
        format.scale = 1
        let renderer = UIGraphicsImageRenderer(size: newSize, format: format)
        return renderer.image { _ in
            self.draw(in: CGRect(origin: .zero, size: newSize))
        }
    }
}

enum Format {
    /// "14,500.00" (fixed) or "5,000" / "2,500.5" (flexible)
    static func number(_ value: Double, fixed: Bool = false) -> String {
        if fixed {
            return value.formatted(.number.precision(.fractionLength(2)))
        } else {
            return value.formatted(.number.precision(.fractionLength(0...2)))
        }
    }

    static func hkd(_ value: Double) -> String {
        "$\(number(value)) HKD"
    }

    static func time(_ date: Date) -> String {
        date.formatted(date: .omitted, time: .shortened)
    }

    static func day(_ date: Date) -> String {
        date.formatted(date: .abbreviated, time: .omitted)
    }

    /// Time if today, otherwise the date
    static func relative(_ date: Date) -> String {
        Calendar.current.isDateInToday(date) ? time(date) : day(date)
    }

    /// "2 days ago"
    static func ago(_ date: Date) -> String {
        RelativeDateTimeFormatter().localizedString(for: date, relativeTo: Date())
    }

    /// 1280 -> "1.3K"
    static func compact(_ value: Int) -> String {
        value >= 1000 ? String(format: "%.1fK", Double(value) / 1000) : "\(value)"
    }

    static func webURL(_ raw: String) -> URL? {
        let clean = raw.trimmed
        guard !clean.isEmpty else { return nil }
        return URL(string: clean.hasPrefix("http") ? clean : "https://\(clean)")
    }
}

/// Tiny JSON <-> UserDefaults helper so key data survives app restarts.
enum Store {
    static func save<T: Encodable>(_ value: T, key: String) {
        if let data = try? JSONEncoder().encode(value) {
            UserDefaults.standard.set(data, forKey: key)
        }
    }

    static func load<T: Decodable>(_ type: T.Type, key: String) -> T? {
        guard let data = UserDefaults.standard.data(forKey: key) else { return nil }
        return try? JSONDecoder().decode(type, from: data)
    }
}

/// Saves user photos as small JPEG files in the Documents folder (UserDefaults only stores the file names).
enum ImageStore {
    private static let cache = NSCache<NSString, UIImage>()

    private static var directory: URL {
        let url = FileManager.default
            .urls(for: .documentDirectory, in: .userDomainMask)[0]
            .appendingPathComponent("LocalLockerImages", isDirectory: true)
        try? FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
        return url
    }

    static func save(_ image: UIImage, maxDimension: CGFloat = 1200) -> String? {
        let resized = image.resized(maxDimension: maxDimension)
        guard let data = resized.jpegData(compressionQuality: 0.75) else { return nil }
        let name = UUID().uuidString + ".jpg"
        do {
            try data.write(to: directory.appendingPathComponent(name))
            cache.setObject(resized, forKey: name as NSString)
            return name
        } catch {
            return nil
        }
    }

    static func load(_ name: String) -> UIImage? {
        if let cached = cache.object(forKey: name as NSString) { return cached }
        let path = directory.appendingPathComponent(name).path
        guard let image = UIImage(contentsOfFile: path) else { return nil }
        cache.setObject(image, forKey: name as NSString)
        return image
    }

    static func delete(_ name: String) {
        cache.removeObject(forKey: name as NSString)
        try? FileManager.default.removeItem(at: directory.appendingPathComponent(name))
    }
}

// MARK: - Data Models
enum ProfileType {
    case business, team
}

enum RoleType: String, CaseIterable, Codable {
    case sponsor = "Business Sponsor"
    case team = "Sports Team"

    /// Teams discover businesses; businesses discover teams.
    var discoverableType: ProfileType {
        self == .team ? .business : .team
    }
}

enum AppearanceMode: String, CaseIterable, Identifiable {
    case system = "System"
    case light = "Light"
    case dark = "Dark"

    var id: String { rawValue }

    var colorScheme: ColorScheme? {
        switch self {
        case .system: return nil
        case .light: return .light
        case .dark: return .dark
        }
    }
}

enum AppTab: Int {
    case discover, messages, wallet, profile
}

enum OfferStatus: String {
    case pending = "Pending"
    case accepted = "Accepted"
    case declined = "Declined"

    var color: Color {
        switch self {
        case .pending: return .logoOrange
        case .accepted: return .green
        case .declined: return .red
        }
    }
}

